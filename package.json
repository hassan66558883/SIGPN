{
  "name": "police-management-system",
  "version": "0.7.0",
  "private": true,
  "description": "SIGPN-T — Système Intégré de Gestion Numérique de la Police Nationale du Tchad : application intégrée et sécurisée (plaintes, affaires, enquêtes, pièces à conviction, arrestations, mandats, opérations, personnel, parc, infractions routières et amendes).",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:security": "tsx --test tests/security/*.test.ts",
    "hr:rotation": "tsx scripts/hr-rotation.ts",
    "alerts:maintain": "tsx scripts/alerts-maintain.ts",
    "hr:check": "tsx scripts/hr-check.ts",
    "hr:import": "tsx scripts/hr-import.ts",
    "traffic:import": "tsx scripts/import-traffic-violations.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "docx": "^9.15.2",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
