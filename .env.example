# Police Management System — environment variables (copy to .env)
NODE_ENV=development
APP_NAME="Police Management System"
APP_URL="http://localhost:3300"

# PostgreSQL. Dev: `npm run db:dev` starts an embedded PostgreSQL on port 5436.
DATABASE_URL="postgresql://pms_app:pms_dev_password@127.0.0.1:5436/pms?schema=public"

# 32+ random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-me-generate-a-real-secret"
# Separate key used to encrypt MFA secrets at rest (32 bytes base64)
DATA_ENCRYPTION_KEY="change-me-generate-a-real-key"

SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=10
# Login protection
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Password policy
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_AGE_DAYS=90

# File storage (absolute or relative to project root)
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB=25
# Backups
BACKUP_DIR="./backups"

# Demo data (fictional). Shared password for demo accounts.
DEMO_PASSWORD="Demo-Pms-2026!"

# Speech-to-text provider: "simulated" (offline demo) or "openai" (requires STT_API_KEY)
STT_PROVIDER="simulated"
STT_API_KEY=""

# Biometric provider adapters: "mock" (offline DEMO/TEST engine) or a real vendor adapter id once
# integrated (e.g. "afis" for fingerprint, "external" for face/voice/anpr). See src/server/biometric/providers.
FINGERPRINT_PROVIDER="mock"
FACE_PROVIDER="mock"
VOICE_PROVIDER="mock"
ANPR_PROVIDER="mock"

# DEMO environment (1 shows the demonstration banner; set 0 in production)
DEMO_MODE=1
