enum TrafficOffenceClass {
  CLASS_2
  CLASS_3
  CLASS_4
  DELIT
}

enum TrafficVehicleType {
  CAR
  PICKUP
  MOTORCYCLE
  MOTO_TAXI
  TRICYCLE
  CYCLE
  MINIBUS
  BUS
  TRUCK
  TRACTOR_TRAILER
  OTHER
}

enum TrafficVehicleStatus {
  ACTIVE
  SUSPENDED
  SEIZED
  STOLEN
  SCRAPPED
}

enum TrafficVehicleDocType {
  REGISTRATION_CARD
  INSURANCE
  TECHNICAL_INSPECTION
  BLUE_CARD
  TRANSPORT_LICENSE
  STICKER
  OTHER
}

enum TrafficControlOutcome {
  COMPLIANT
  INFRACTION
}

enum TrafficTicketStatus {
  ISSUED
  CANCELLED
}

enum TrafficFineStatus {
  PENDING
  TO_PAY
  PARTIALLY_PAID
  PAID
  CONTESTED
  CANCELLED
}

enum TrafficPaymentMethod {
  CASH
  ELECTRONIC
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum TrafficPaymentStatus {
  COMPLETED
  VOIDED
}

enum TrafficEvidenceKind {
  PHOTO
  VIDEO
  DOCUMENT
}

/// The three parts of the official offence table: A road offences, B cycles & motorcycles, C moto-taxis.
model TrafficViolationCategory {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  sourceHeading String?
  sortOrder     Int
  createdAt     DateTime @default(now())

  violations TrafficViolation[]
}

/// Legal text of an offence, copied verbatim from the source table (several offences may share one).
model TrafficLegalReference {
  id        String   @id @default(cuid())
  reference String   @unique
  createdAt DateTime @default(now())

  violations TrafficViolation[]
}

/// Offence catalogue imported verbatim from the official table (name, class, legal text, flat fine).
/// `fineAmountFcfa` is null for a « Délit » (the source states « Interdiction d'arbitrer » instead of an amount).
model TrafficViolation {
  id               String                   @id @default(cuid())
  code             String                   @unique
  categoryId       String
  category         TrafficViolationCategory @relation(fields: [categoryId], references: [id])
  legalReferenceId String
  legalReference   TrafficLegalReference    @relation(fields: [legalReferenceId], references: [id])
  name             String
  offenceClass     TrafficOffenceClass
  classText        String
  fineAmountFcfa   Int?
  fineAmountText   String
  isFineEligible   Boolean
  sourcePage       Int
  sourceOrder      Int                      @unique
  sourceNote       String?
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  ticketOffences TrafficTicketOffence[]

  @@index([categoryId])
  @@index([offenceClass])
  @@index([name])
}

/// Driver profile of a Person (identity, phone and address stay on Person; the CNI is a PersonIdentifier).
model TrafficDriver {
  id               String    @id @default(cuid())
  personId         String    @unique
  person           Person    @relation(fields: [personId], references: [id])
  licenseNumber    String?   @unique
  licenseCategory  String?
  licenseIssuedAt  DateTime?
  licenseExpiresAt DateTime?
  licenseIssuedBy  String?
  photoDocumentId  String?   @unique
  photo            Document? @relation("TrafficDriverPhoto", fields: [photoDocumentId], references: [id])
  notes            String?
  createdById      String
  createdBy        User      @relation("TrafficDriverCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  controls TrafficControl[]
}

/// Civilian / commercial vehicle registry (the fleet `Vehicle` model is the police's own vehicles).
model TrafficVehicle {
  id                           String               @id @default(cuid())
  plateNumber                  String               @unique
  registrationCardNumber       String?              @unique
  make                         String?
  model                        String?
  color                        String?
  vehicleType                  TrafficVehicleType   @default(CAR)
  year                         Int?
  ownerPersonId                String?
  owner                        Person?              @relation("TrafficVehicleOwner", fields: [ownerPersonId], references: [id])
  chassisNumber                String?              @unique
  insuranceCompany             String?
  insurancePolicyNumber        String?
  insuranceExpiresAt           DateTime?
  technicalInspectionExpiresAt DateTime?
  status                       TrafficVehicleStatus @default(ACTIVE)
  notes                        String?
  createdById                  String
  createdBy                    User                 @relation("TrafficVehicleCreatedBy", fields: [createdById], references: [id])
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  documents TrafficVehicleDocument[]
  controls  TrafficControl[]

  @@index([ownerPersonId])
}

model TrafficVehicleDocument {
  id         String                @id @default(cuid())
  vehicleId  String
  vehicle    TrafficVehicle        @relation(fields: [vehicleId], references: [id])
  type       TrafficVehicleDocType
  number     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  documentId String?               @unique
  document   Document?             @relation(fields: [documentId], references: [id])
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([vehicleId, type])
}

/// A roadside control by an officer. May end without offence (COMPLIANT) or lead to one PV (ticket).
model TrafficControl {
  id             String                @id @default(cuid())
  number         String                @unique
  controlledAt   DateTime
  location       String
  latitude       Float?
  longitude      Float?
  stationId      String
  station        Station               @relation(fields: [stationId], references: [id])
  regionId       String
  region         Region                @relation(fields: [regionId], references: [id])
  officerId      String
  officer        User                  @relation("TrafficControlOfficer", fields: [officerId], references: [id])
  driverPersonId String?
  driverPerson   Person?               @relation("TrafficControlDriver", fields: [driverPersonId], references: [id])
  driverId       String?
  driver         TrafficDriver?        @relation(fields: [driverId], references: [id])
  licenseNumber  String?
  vehicleId      String?
  vehicle        TrafficVehicle?       @relation(fields: [vehicleId], references: [id])
  plateNumber    String?
  vehicleType    TrafficVehicleType    @default(CAR)
  vehicleMake    String?
  vehicleColor   String?
  outcome        TrafficControlOutcome @default(COMPLIANT)
  observations   String?
  isDemo         Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  ticket   TrafficTicket?
  evidence TrafficEvidence[]

  @@index([stationId, controlledAt])
  @@index([regionId, controlledAt])
  @@index([officerId, controlledAt])
  @@index([controlledAt])
  @@index([plateNumber])
  @@index([driverPersonId])
}

/// Procès-verbal électronique. Offence lines are snapshots of the catalogue at issue time;
/// `contentHash`/`signature` seal the content (tamper evidence) and `verificationToken` feeds the public QR check.
model TrafficTicket {
  id                      String              @id @default(cuid())
  number                  String              @unique
  verificationToken       String              @unique
  controlId               String              @unique
  control                 TrafficControl      @relation(fields: [controlId], references: [id])
  status                  TrafficTicketStatus @default(ISSUED)
  issuedAt                DateTime            @default(now())
  stationId               String
  station                 Station             @relation(fields: [stationId], references: [id])
  regionId                String
  region                  Region              @relation(fields: [regionId], references: [id])
  issuedById              String
  issuedBy                User                @relation("TrafficTicketIssuedBy", fields: [issuedById], references: [id])
  driverPersonId          String?
  driverPerson            Person?             @relation("TrafficTicketDriver", fields: [driverPersonId], references: [id])
  plateNumber             String?
  totalFineFcfa           Int
  hasNonSettleableOffence Boolean             @default(false)
  observations            String?
  contentHash             String
  signature               String
  signedAt                DateTime            @default(now())
  cancelledAt             DateTime?
  cancelledById           String?
  cancelledBy             User?               @relation("TrafficTicketCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason      String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  offences TrafficTicketOffence[]
  fine     TrafficFine?

  @@index([stationId, issuedAt])
  @@index([regionId, issuedAt])
  @@index([issuedById, issuedAt])
  @@index([plateNumber])
  @@index([driverPersonId])
}

model TrafficTicketOffence {
  id             String           @id @default(cuid())
  ticketId       String
  ticket         TrafficTicket    @relation(fields: [ticketId], references: [id])
  violationId    String
  violation      TrafficViolation @relation(fields: [violationId], references: [id])
  code           String
  name           String
  classText      String
  legalReference String
  amountFcfa     Int?
  amountText     String
  createdAt      DateTime         @default(now())

  @@unique([ticketId, violationId])
  @@index([violationId])
}

model TrafficFine {
  id             String            @id @default(cuid())
  number         String            @unique
  ticketId       String            @unique
  ticket         TrafficTicket     @relation(fields: [ticketId], references: [id])
  status         TrafficFineStatus @default(TO_PAY)
  amountFcfa     Int
  amountPaidFcfa Int               @default(0)
  issuedAt       DateTime          @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  driverPersonId String?
  driverPerson   Person?           @relation("TrafficFineDriver", fields: [driverPersonId], references: [id])
  plateNumber    String?
  officerId      String
  officer        User              @relation("TrafficFineOfficer", fields: [officerId], references: [id])
  stationId      String
  station        Station           @relation(fields: [stationId], references: [id])
  regionId       String
  region         Region            @relation(fields: [regionId], references: [id])
  contestedAt    DateTime?
  contestReason  String?
  statusNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  payments TrafficPayment[]
  receipts TrafficReceipt[]

  @@index([status])
  @@index([stationId, issuedAt])
  @@index([regionId, issuedAt])
  @@index([driverPersonId])
  @@index([plateNumber])
}

model TrafficPayment {
  id                   String               @id @default(cuid())
  number               String               @unique
  fineId               String
  fine                 TrafficFine          @relation(fields: [fineId], references: [id])
  amountFcfa           Int
  method               TrafficPaymentMethod
  provider             String?
  transactionReference String?
  paidAt               DateTime
  receivedById         String
  receivedBy           User                 @relation("TrafficPaymentReceivedBy", fields: [receivedById], references: [id])
  stationId            String?
  station              Station?             @relation(fields: [stationId], references: [id])
  paymentPoint         String?
  status               TrafficPaymentStatus @default(COMPLETED)
  voidedAt             DateTime?
  voidedById           String?
  voidedBy             User?                @relation("TrafficPaymentVoidedBy", fields: [voidedById], references: [id])
  voidReason           String?
  notes                String?
  createdAt            DateTime             @default(now())

  receipt TrafficReceipt?

  @@unique([method, transactionReference])
  @@index([fineId])
  @@index([paidAt])
}

model TrafficReceipt {
  id                String         @id @default(cuid())
  number            String         @unique
  verificationToken String         @unique
  paymentId         String         @unique
  payment           TrafficPayment @relation(fields: [paymentId], references: [id])
  fineId            String
  fine              TrafficFine    @relation(fields: [fineId], references: [id])
  amountFcfa        Int
  issuedAt          DateTime       @default(now())
  issuedById        String
  issuedBy          User           @relation("TrafficReceiptIssuedBy", fields: [issuedById], references: [id])

  @@index([fineId])
}

model TrafficEvidence {
  id           String              @id @default(cuid())
  controlId    String
  control      TrafficControl      @relation(fields: [controlId], references: [id])
  kind         TrafficEvidenceKind @default(PHOTO)
  documentId   String              @unique
  document     Document            @relation(fields: [documentId], references: [id])
  caption      String?
  latitude     Float?
  longitude    Float?
  capturedAt   DateTime?
  uploadedById String
  uploadedBy   User                @relation("TrafficEvidenceUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([controlId])
}
