  documents Document[]

  @@index([stationId, status])
  @@index([plannedStart])
}

model OperationTeam {
  id          String            @id @default(cuid())
  operationId String
  operation   Operation         @relation(fields: [operationId], references: [id])
  name        String
  leaderId    String?
  leader      Officer?          @relation(fields: [leaderId], references: [id])
  mission     String?
  members     OperationMember[]
}

model OperationMember {
  teamId    String
  team      OperationTeam @relation(fields: [teamId], references: [id])
  officerId String
  officer   Officer       @relation(fields: [officerId], references: [id])
  role      String?

  @@id([teamId, officerId])
}

model OperationResource {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  description String
  quantity    Int       @default(1)
}

