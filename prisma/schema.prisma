enum DocumentEntity {
  CASE
  COMPLAINT
  EVIDENCE
  PERSON
  ARREST
  WARRANT
  INCIDENT
  PATROL
  OPERATION
  VEHICLE
  OFFICER
  STATEMENT
  INTERVIEW
  INVESTIGATION
  REPORT
  WANTED_PERSON
  TRAFFIC_CONTROL
  TRAFFIC_TICKET
  TRAFFIC_DRIVER
  TRAFFIC_VEHICLE
  GENERAL
}

enum DocumentCategory {
  PHOTO
  SCAN
  FORM
  REPORT
  AUDIO
  VIDEO
  IDENTITY
  LEGAL
  OTHER
}

enum Classification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
  SECRET
}

model Document {
  id             String           @id @default(cuid())
  title          String
  entityType     DocumentEntity
  entityId       String?
  category       DocumentCategory @default(OTHER)
  classification Classification   @default(INTERNAL)
  description    String?
  currentVersion Int              @default(1)
  uploadedById   String
  uploadedBy     User             @relation(fields: [uploadedById], references: [id])
  stationId      String?
  station        Station?         @relation(fields: [stationId], references: [id])
  caseId         String?
  case           Case?            @relation(fields: [caseId], references: [id])
  evidenceId     String?
  evidence       Evidence?        @relation(fields: [evidenceId], references: [id])
  warrantId      String?
  warrant        Warrant?         @relation(fields: [warrantId], references: [id])
  arrestId       String?
  arrest         Arrest?          @relation(fields: [arrestId], references: [id])
  incidentId     String?
  incident       Incident?        @relation(fields: [incidentId], references: [id])
  operationId    String?
  operation      Operation?       @relation(fields: [operationId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id])
  wantedPersonId String?
  wantedPerson   WantedPerson?    @relation("WantedPersonAttachment", fields: [wantedPersonId], references: [id])
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  versions               DocumentVersion[]
  transcript             Transcript?
  generated              GeneratedReport?
  mainPhotoOfWanted      WantedPerson?           @relation("WantedMainPhoto")
  trafficDriverPhoto     TrafficDriver?          @relation("TrafficDriverPhoto")
  trafficEvidence        TrafficEvidence?
  trafficVehicleDocument TrafficVehicleDocument?

  @@index([entityType, entityId])
  @@index([caseId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  version      Int
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  sha256       String
  changeNote   String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@unique([documentId, version])
}

enum ReportType {
  CASE
  INVESTIGATION
  ARREST
  EVIDENCE
  INCIDENT
  PATROL
  STATION
  STATISTICAL
}

model GeneratedReport {
  id            String     @id @default(cuid())
  number        String     @unique
  type          ReportType
  title         String
  parameters    Json?
  entityId      String?
  generatedById String
  generatedBy   User       @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime   @default(now())
  documentId    String?    @unique
  document      Document?  @relation(fields: [documentId], references: [id])

  @@index([type, generatedAt])
}

enum NotificationKind {
  INFO
  ASSIGNMENT
  DEADLINE
  APPROVAL
  ALERT
  SECURITY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(INFO)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// ------------------------------------------------------------
// 12. AUDIT, SYSTEM, BACKUP
// ------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Immutable audit log (DB trigger forbids UPDATE/DELETE).
model AuditLog {
  id          String       @id @default(cuid())
  at          DateTime     @default(now())
  actorId     String?
  actor       User?        @relation(fields: [actorId], references: [id])
  actorLabel  String
  action      String
  module      String
  entityType  String?
  entityId    String?
  entityLabel String?
  summary     String
  before      Json?
  after       Json?
  outcome     AuditOutcome @default(SUCCESS)
  ipAddress   String?
  userAgent   String?
  sessionId   String?

  @@index([at])
  @@index([actorId, at])
  @@index([entityType, entityId])
  @@index([module, action])
}

model DocumentSequence {
  key    String @id
  prefix String
  width  Int    @default(5)
  next   Int    @default(1)
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED
  RESTORED
}

model BackupRecord {
  id            String       @id @default(cuid())
  type          String       @default("FULL")
  status        BackupStatus @default(RUNNING)
  fileName      String?
  sizeBytes     Int?
  sha256        String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  notes         String?
  triggeredById String?
  triggeredBy   User?        @relation(fields: [triggeredById], references: [id])
}

// ------------------------------------------------------------
// 13. BIOMETRIC & FORENSIC IDENTIFICATION
// ------------------------------------------------------------

enum BiometricType {
  FINGERPRINT
  FACE
  VOICE
  ANPR
}

enum BiometricSearchMode {
  VERIFY_1_1
  IDENTIFY_1_N
}

enum BiometricSearchResult {
  NO_MATCH
  POTENTIAL_MATCH
  VERIFIED_MATCH
  ERROR
}

enum BiometricAction {
  NONE
  SENT_FOR_VERIFICATION
  VERIFIED_BY_INVESTIGATOR
  REJECTED
  LINKED_TO_CASE
}

enum FingerPosition {
  RIGHT_THUMB
  RIGHT_INDEX
  RIGHT_MIDDLE
  RIGHT_RING
  RIGHT_LITTLE
  LEFT_THUMB
  LEFT_INDEX
  LEFT_MIDDLE
  LEFT_RING
  LEFT_LITTLE
  UNKNOWN
}

enum LprStatus {
  NEW
  REVIEWED
  LINKED_TO_CASE
  DISMISSED
}

/// Encrypted biometric template (never a raw image). The optional source capture, if retained, is a
/// normal Evidence row (hash, chain of custody) — biometric tables never hold file bytes themselves.
model FingerprintRecord {
  id                String         @id @default(cuid())
  number            String         @unique
  personId          String
  person            Person         @relation(fields: [personId], references: [id])
  position          FingerPosition @default(UNKNOWN)
  templateSecretEnc String
  quality           Int?
  device            String?
  sourceEvidenceId  String?
  sourceEvidence    Evidence?      @relation(fields: [sourceEvidenceId], references: [id])
  capturedById      String
  capturedBy        User           @relation("BiometricCapturedBy", fields: [capturedById], references: [id])
  capturedAt        DateTime       @default(now())
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([personId])
}

model FaceRecord {
  id                String    @id @default(cuid())
  number            String    @unique
  personId          String
  person            Person    @relation(fields: [personId], references: [id])
  templateSecretEnc String
  quality           Int?
  device            String?
  sourceEvidenceId  String?
  sourceEvidence    Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  capturedById      String
  capturedBy        User      @relation("BiometricCapturedBy", fields: [capturedById], references: [id])
  capturedAt        DateTime  @default(now())
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([personId])
}

model VoiceRecord {
  id                String    @id @default(cuid())
  number            String    @unique
  personId          String
  person            Person    @relation(fields: [personId], references: [id])
  templateSecretEnc String
  durationSeconds   Int?
  device            String?
  sourceEvidenceId  String?
  sourceEvidence    Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  capturedById      String
  capturedBy        User      @relation("BiometricCapturedBy", fields: [capturedById], references: [id])
  capturedAt        DateTime  @default(now())
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([personId])
}

/// One row per plate-read event. A plate's "vehicle profile" is derived by querying all rows for
/// the same plateNumber (most recent first) — deliberately not a master vehicle table (see Vehicle,
/// which is the internal fleet, not a civilian/suspect vehicle registry).
model LicensePlateDetection {
  id               String    @id @default(cuid())
  number           String    @unique
  plateNumber      String
  vehicleMake      String?
  vehicleModel     String?
  vehicleColor     String?
  cameraId         String?
  locationText     String?
  latitude         Float?
  longitude        Float?
  detectedAt       DateTime
  caseId           String?
  case             Case?     @relation(fields: [caseId], references: [id])
  personId         String?
  person           Person?   @relation(fields: [personId], references: [id])
  sourceEvidenceId String?
  sourceEvidence   Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  status           LprStatus @default(NEW)
  recordedById     String
  recordedBy       User      @relation(fields: [recordedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([plateNumber])
  @@index([caseId])
  @@index([detectedAt])
}

/// The mandatory audit/history record for every biometric search (spec: no anonymous search, case +
/// reason + officer + type required). Core fields are write-once; only recordBiometricAction() may
/// later touch action/actionNotes/actionById/actionAt. No delete path exists anywhere in the app.
model BiometricSearch {
  id               String                @id @default(cuid())
  number           String                @unique
  type             BiometricType
  mode             BiometricSearchMode
  caseId           String
  case             Case                  @relation(fields: [caseId], references: [id])
  reason           String
  officerId        String
  officer          User                  @relation("BiometricSearchOfficer", fields: [officerId], references: [id])
  device           String?
  location         String?
  parameters       Json?
  resultCount      Int                   @default(0)
  result           BiometricSearchResult @default(NO_MATCH)
  topMatchScore    Decimal?              @db.Decimal(5, 2)
  topMatchPersonId String?
  topMatchPerson   Person?               @relation("BiometricTopMatch", fields: [topMatchPersonId], references: [id])
  action           BiometricAction       @default(NONE)
  actionNotes      String?
  actionById       String?
  actionBy         User?                 @relation("BiometricSearchActionBy", fields: [actionById], references: [id])
  actionAt         DateTime?
  isDemo           Boolean               @default(true)
  ipAddress        String?
  createdAt        DateTime              @default(now())

  matches BiometricMatch[]

  @@index([caseId])
  @@index([type])
  @@index([officerId])
  @@index([createdAt])
}

model BiometricMatch {
  id          String          @id @default(cuid())
  searchId    String
  search      BiometricSearch @relation(fields: [searchId], references: [id])
  personId    String?
  person      Person?         @relation(fields: [personId], references: [id])
  score       Decimal         @db.Decimal(5, 2)
  sourceLabel String
  rank        Int
  createdAt   DateTime        @default(now())

  @@unique([searchId, rank])
  @@index([searchId])
}

