// ============================================================
// POLICE MANAGEMENT SYSTEM (PMS) — PostgreSQL data model
// Single source of truth for the ERD (docs/DATABASE_DOCUMENTATION.md).
// Conventions:
//  - ids are cuid strings; business numbers (CASE-2026-00001) come from DocumentSequence
//  - critical records are never hard-deleted: deletedAt / status / supersede
//  - AuditLog and CustodyEvent are append-only (DB triggers block UPDATE/DELETE)
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// 1. IDENTITY, ACCESS & SECURITY
// ------------------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  LOCKED
  SUSPENDED
  DISABLED
}

/// Data visibility scope granted by a role.
/// NATIONAL = whole country · REGIONAL = one province · DEPARTMENTAL = one administrative department ·
/// STATION = one police structure and its child posts/units · OWN = own records only.
enum ScopeLevel {
  NATIONAL
  REGIONAL
  DEPARTMENTAL
  STATION
  OWN
}

model Organization {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  shortName   String?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  regions     Region[]
  users       User[]
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  scopeLevel  ScopeLevel       @default(STATION)
  requiresMfa Boolean          @default(false)
  isSystem    Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  module      String
  action      String
  description String?
  roles       RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String           @id @default(cuid())
  username           String           @unique
  email              String           @unique
  firstName          String
  lastName           String
  phone              String?
  passwordHash       String
  passwordChangedAt  DateTime         @default(now())
  mustChangePassword Boolean          @default(false)
  status             UserStatus       @default(ACTIVE)
  failedLoginCount   Int              @default(0)
  lockedUntil        DateTime?
  mfaEnabled         Boolean          @default(false)
  mfaSecretEnc       String?
  mfaEnrolledAt      DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  roleId             String
  role               Role             @relation(fields: [roleId], references: [id])
  organizationId     String?
  organization       Organization?    @relation(fields: [organizationId], references: [id])
  regionId           String?
  region             Region?          @relation(fields: [regionId], references: [id])
  adminDepartmentId  String?
  adminDepartment    AdminDepartment? @relation(fields: [adminDepartmentId], references: [id])
  stationId          String?
  station            Station?         @relation(fields: [stationId], references: [id])
  officer            Officer?
  createdById        String?
  createdBy          User?            @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers       User[]           @relation("UserCreatedBy")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?

  sessions            Session[]
  loginChallenges     LoginChallenge[]
  passwordResetTokens PasswordResetToken[] @relation("ResetForUser")
  issuedResetTokens   PasswordResetToken[] @relation("ResetIssuedBy")
  mfaRecoveryCodes    MfaRecoveryCode[]
  apiKeys             ApiKey[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  passwordHistory     PasswordHistory[]

  // domain back-relations
  personsCreated             Person[]                   @relation("PersonCreatedBy")
  complaintsCreated          Complaint[]                @relation("ComplaintCreatedBy")
  complaintsAssigned         Complaint[]                @relation("ComplaintAssignedTo")
  complaintsReviewed         Complaint[]                @relation("ComplaintReviewedBy")
  casesCreated               Case[]                     @relation("CaseCreatedBy")
  casesLead                  Case[]                     @relation("CaseLead")
  casesSupervised            Case[]                     @relation("CaseSupervisor")
  caseAssignments            CaseAssignment[]           @relation("CaseAssignmentUser")
  caseAssignmentsMade        CaseAssignment[]           @relation("CaseAssignmentBy")
  caseEvents                 CaseEvent[]
  caseNotes                  CaseNote[]
  tasksAssigned              Task[]                     @relation("TaskAssignee")
  tasksCreated               Task[]                     @relation("TaskCreator")
  investigationsLead         Investigation[]            @relation("InvestigationLead")
  investigationsReviewed     Investigation[]            @relation("InvestigationReviewer")
  reportsAuthored            InvestigationReport[]      @relation("ReportAuthor")
  reportsReviewed            InvestigationReport[]      @relation("ReportReviewer")
  statementsTaken            Statement[]
  interviewsLed              Interview[]                @relation("InterviewLead")
  transcriptsReviewed        Transcript[]               @relation("TranscriptReviewer")
  transcriptsApproved        Transcript[]               @relation("TranscriptApprover")
  evidenceCollected          Evidence[]                 @relation("EvidenceCollectedBy")
  evidenceCustody            Evidence[]                 @relation("EvidenceCustodian")
  custodyFrom                CustodyEvent[]             @relation("CustodyFrom")
  custodyTo                  CustodyEvent[]             @relation("CustodyTo")
  custodyRecorded            CustodyEvent[]             @relation("CustodyRecordedBy")
  custodyAuthorized          CustodyEvent[]             @relation("CustodyAuthorizedBy")
  warrantsRequested          Warrant[]                  @relation("WarrantRequestedBy")
  warrantsApproved           Warrant[]                  @relation("WarrantApprovedBy")
  warrantsExecuted           Warrant[]                  @relation("WarrantExecutedBy")
  arrestsRecorded            Arrest[]
  detentionsRecorded         Detention[]
  detentionLogs              DetentionLog[]
  wantedIssued               WantedPerson[]             @relation("WantedIssuedBy")
  wantedApproved             WantedPerson[]             @relation("WantedApprovedBy")
  wantedVerified             WantedPerson[]             @relation("WantedVerifiedBy")
  wantedSightingsLogged      WantedSighting[]
  wantedVehiclesAdded        WantedVehicle[]
  incidentsReported          Incident[]
  patrolsCreated             Patrol[]
  operationsCreated          Operation[]
  documentsUploaded          Document[]
  documentVersions           DocumentVersion[]
  generatedReports           GeneratedReport[]
  settingsUpdated            SystemSetting[]
  backups                    BackupRecord[]
  officerAssignments         OfficerAssignment[]
  trainingsRecorded          Training[]
  careerEventsRecorded       CareerEvent[]
  rotationExceptionsCreated  RotationException[]
  leavesRequested            LeaveRequest[]             @relation("LeaveRequestedBy")
  leavesDecided              LeaveRequest[]             @relation("LeaveDecidedBy")
  disciplineOpened           DisciplinaryCase[]         @relation("DisciplineOpenedBy")
  disciplineDecided          DisciplinaryCase[]         @relation("DisciplineDecidedBy")
  hrDocumentsCreated         HrDocument[]
  payElementsRequested       OfficerPayElement[]        @relation("PayElementRequestedBy")
  payElementsValidated       OfficerPayElement[]        @relation("PayElementValidatedBy")
  payScaleCreated            PayScaleEntry[]            @relation("PayScaleCreatedBy")
  payScaleValidated          PayScaleEntry[]            @relation("PayScaleValidatedBy")
  payRunsGenerated           PayRun[]                   @relation("PayRunGeneratedBy")
  payRunsValidated           PayRun[]                   @relation("PayRunValidatedBy")
  transfersProposed          TransferRequest[]          @relation("TransferProposedBy")
  transfersReviewed          TransferRequest[]          @relation("TransferReviewedBy")
  transfersValidated         TransferRequest[]          @relation("TransferValidatedBy")
  maintenanceRecorded        MaintenanceRecord[]
  fuelLogs                   FuelLog[]
  fingerprintsCaptured       FingerprintRecord[]        @relation("BiometricCapturedBy")
  facesCaptured              FaceRecord[]               @relation("BiometricCapturedBy")
  voicesCaptured             VoiceRecord[]              @relation("BiometricCapturedBy")
  plateDetectionsLogged      LicensePlateDetection[]
  biometricSearchesRun       BiometricSearch[]          @relation("BiometricSearchOfficer")
  biometricActionsTaken      BiometricSearch[]          @relation("BiometricSearchActionBy")
  trafficDriversCreated      TrafficDriver[]            @relation("TrafficDriverCreatedBy")
  trafficVehiclesCreated     TrafficVehicle[]           @relation("TrafficVehicleCreatedBy")
  trafficControlsRecorded    TrafficControl[]           @relation("TrafficControlOfficer")
  trafficTicketsIssued       TrafficTicket[]            @relation("TrafficTicketIssuedBy")
  trafficTicketsCancelled    TrafficTicket[]            @relation("TrafficTicketCancelledBy")
  trafficFinesIssued         TrafficFine[]              @relation("TrafficFineOfficer")
  trafficPaymentsReceived    TrafficPayment[]           @relation("TrafficPaymentReceivedBy")
  trafficPaymentsVoided      TrafficPayment[]           @relation("TrafficPaymentVoidedBy")
  trafficReceiptsIssued      TrafficReceipt[]           @relation("TrafficReceiptIssuedBy")
  cashRegisters              TrafficCashRegister[]      @relation("CashRegisterAgent")
  cashRegistersClosed        TrafficCashRegister[]      @relation("CashRegisterClosedBy")
  cashRegistersBlocked       TrafficCashRegister[]      @relation("CashRegisterBlockedBy")
  cashDailyClosures          TrafficDailyClosure[]      @relation("DailyClosureClosedBy")
  cashCollections            TrafficRevenueCollection[] @relation("RevenueCollectionAgent")
  cashCollectionsVerified    TrafficRevenueCollection[] @relation("RevenueCollectionVerifiedBy")
  cashDepositsAgent          TrafficDeposit[]           @relation("DepositAgent")
  cashDepositsMade           TrafficDeposit[]           @relation("DepositMadeBy")
  cashDepositsReceived       TrafficDeposit[]           @relation("DepositReceivedBy")
  cashDepositsReviewed       TrafficDeposit[]           @relation("DepositReviewedBy")
  cashDepositsValidated      TrafficDeposit[]           @relation("DepositValidatedBy")
  cashDepositSlips           TrafficDepositReceipt[]    @relation("DepositSlipIssuedBy")
  cashReconciliations        TrafficReconciliation[]    @relation("ReconciliationDecidedBy")
  cashDiscrepanciesAgent     TrafficCashDiscrepancy[]   @relation("DiscrepancyAgent")
  cashDiscrepanciesValidated TrafficCashDiscrepancy[]   @relation("DiscrepancyValidatedBy")
  trafficEvidenceUploaded    TrafficEvidence[]          @relation("TrafficEvidenceUploadedBy")

  @@index([roleId])
  @@index([stationId])
  @@index([regionId])
  @@index([status])
  @@index([lastName, firstName])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  ipAddress     String?
  userAgent     String?
  mfaVerified   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Short-lived second-factor challenge created after a correct password.
model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ipAddress  String?
  userAgent  String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("ResetForUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  issuedById String?
  issuedBy   User?     @relation("ResetIssuedBy", fields: [issuedById], references: [id])
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
}

/// Brute-force tracking: every login attempt (success or failure) by identifier and IP.
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ipAddress  String?
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipAddress, createdAt])
}

/// Personal API keys for REST clients (Bearer). Scoped to the owner's permissions.
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// ------------------------------------------------------------
// 2. ORGANIZATION, TERRITORY & PERSONNEL
// Territorial hierarchy (Chad): Country (Organization) → Province (Region) → Administrative department
// (AdminDepartment) → Commune / Sous-préfecture (Commune) → Quartier / Localité (Locality).
// Police hierarchy: Station (commissariat) → child Station (POST / UNIT via parentId) → Department (service) → Officer.
// `isDemo` marks fictional demonstration records as opposed to official referential data.
// ------------------------------------------------------------

/// Province (kept as table "Region" for backward compatibility; presented as "Province" in the UI).
model Region {
  id               String                     @id @default(cuid())
  organizationId   String
  organization     Organization               @relation(fields: [organizationId], references: [id])
  code             String                     @unique
  name             String
  capital          String?
  isActive         Boolean                    @default(true)
  isDemo           Boolean                    @default(false)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  adminDepartments AdminDepartment[]
  stations         Station[]
  users            User[]
  persons          Person[]
  complaints       Complaint[]
  cases            Case[]
  incidents        Incident[]
  operations       Operation[]
  wantedPersons    WantedPerson[]
  trafficControls  TrafficControl[]
  trafficTickets   TrafficTicket[]
  trafficFines     TrafficFine[]
  cashRegisters    TrafficCashRegister[]
  cashCollections  TrafficRevenueCollection[]
  cashDeposits     TrafficDeposit[]
}

/// Administrative department (département) of a province.
model AdminDepartment {
  id        String    @id @default(cuid())
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id])
  code      String    @unique
  name      String
  capital   String?
  isActive  Boolean   @default(true)
  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  communes  Commune[]
  stations  Station[]
  users     User[]

  @@index([regionId])
}

enum CommuneType {
  COMMUNE
  SOUS_PREFECTURE
  ARRONDISSEMENT
}

/// Commune, sous-préfecture or urban arrondissement of an administrative department.
model Commune {
  id                String          @id @default(cuid())
  adminDepartmentId String
  adminDepartment   AdminDepartment @relation(fields: [adminDepartmentId], references: [id])
  code              String          @unique
  name              String
  type              CommuneType     @default(COMMUNE)
  isActive          Boolean         @default(true)
  isDemo            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  localities        Locality[]
  stations          Station[]

  @@index([adminDepartmentId])
}

enum LocalityType {
  QUARTIER
  VILLAGE
  CANTON
  LOCALITE
}

/// Quartier / village / localité (only when official data is available; otherwise demo).
model Locality {
  id        String       @id @default(cuid())
  communeId String
  commune   Commune      @relation(fields: [communeId], references: [id])
  code      String?      @unique
  name      String
  type      LocalityType @default(QUARTIER)
  isActive  Boolean      @default(true)
  isDemo    Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  stations  Station[]

  @@index([communeId])
}

enum StationType {
  HEADQUARTERS
  DELEGATION
  PROVINCIAL_DIRECTION
  DEPARTMENTAL_DIRECTION
  CENTRAL_STATION
  STATION
  POST
  UNIT
  BRIGADE
  SPECIAL_UNIT
}

enum StationStatus {
  ACTIVE
  INACTIVE
  UNDER_CONSTRUCTION
  PLANNED
}

/// Police structure: commissariat, poste, unité, brigade, direction. Posts and units hang under a parent station.
model Station {
  publicVisible     Boolean          @default(false)
  publicAddress     String?
  publicPhone       String?
  publicHours       String?
  publicVerifiedAt  DateTime?
  publicVerifiedById String?
  alertDeliveries   AlertDelivery[]
  presence          StationPresence?
  id                String           @id @default(cuid())
  regionId          String
  region            Region           @relation(fields: [regionId], references: [id])
  adminDepartmentId String?
  adminDepartment   AdminDepartment? @relation(fields: [adminDepartmentId], references: [id])
  communeId         String?
  commune           Commune?         @relation(fields: [communeId], references: [id])
  localityId        String?
  locality          Locality?        @relation(fields: [localityId], references: [id])
  parentId          String?
  parent            Station?         @relation("StationHierarchy", fields: [parentId], references: [id])
  children          Station[]        @relation("StationHierarchy")
  code              String           @unique
  name              String
  type              StationType      @default(STATION)
  status            StationStatus    @default(ACTIVE)
  address           String?
  city              String?
  phone             String?
  email             String?
  latitude          Float?
  longitude         Float?
  commanderId       String?          @unique
  commander         Officer?         @relation("StationCommander", fields: [commanderId], references: [id])
  isActive          Boolean          @default(true)
  isDemo            Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  departments        Department[]
  officers           Officer[]
  users              User[]
  complaints         Complaint[]
  cases              Case[]
  arrests            Arrest[]
  detentions         Detention[]
  incidents          Incident[]
  patrols            Patrol[]
  zones              Zone[]
  operations         Operation[]
  vehicles           Vehicle[]
  storageLocations   StorageLocation[]
  officerAssignments OfficerAssignment[]
  documents          Document[]
  persons            Person[]
  wantedPersons      WantedPerson[]
  trafficControls    TrafficControl[]
  trafficTickets     TrafficTicket[]
  trafficFines       TrafficFine[]
  trafficPayments    TrafficPayment[]
  cashRegisters      TrafficCashRegister[]
  cashCollections    TrafficRevenueCollection[]
  cashDeposits       TrafficDeposit[]
  transfersFrom      TransferRequest[]          @relation("TransferFrom")
  transfersTo        TransferRequest[]          @relation("TransferTo")
  attendance         AttendanceRecord[]
  leaveRequests      LeaveRequest[]
  hrDocuments        HrDocument[]

  @@index([regionId])
  @@index([adminDepartmentId])
  @@index([communeId])
  @@index([parentId])
  @@index([status])
}

enum DepartmentType {
  COMMAND
  INVESTIGATION
  PATROL
  TRAFFIC
  FORENSICS
  INTELLIGENCE
  CUSTODY
  LOGISTICS
  ADMINISTRATION
  SPECIAL
}

model Department {
  id        String         @id @default(cuid())
  stationId String
  station   Station        @relation(fields: [stationId], references: [id])
  code      String
  name      String
  type      DepartmentType @default(INVESTIGATION)
  headId    String?        @unique
  head      Officer?       @relation("DepartmentHead", fields: [headId], references: [id])
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  officers           Officer[]
  cases              Case[]
  officerAssignments OfficerAssignment[]

  @@unique([stationId, code])
}

enum RankCategory {
  COMMISSIONER
  OFFICER
  INSPECTOR
  NON_COMMISSIONED
  CONSTABLE
  CIVILIAN
}

model Rank {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  level       Int
  category    RankCategory        @default(CONSTABLE)
  isActive    Boolean             @default(true)
  officers    Officer[]
  assignments OfficerAssignment[]
  payScale    PayScaleEntry[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum DutyStatus {
  ON_DUTY
  OFF_DUTY
  ON_LEAVE
  TRAINING
  SUSPENDED
  RETIRED
  DECEASED
}

model Officer {
  id           String      @id @default(cuid())
  badgeNumber  String      @unique
  firstName    String
  lastName     String
  gender       Gender      @default(UNKNOWN)
  dateOfBirth  DateTime?
  phone        String?
  email        String?
  rankId       String
  rank         Rank        @relation(fields: [rankId], references: [id])
  stationId    String
  station      Station     @relation(fields: [stationId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  dutyStatus   DutyStatus  @default(ON_DUTY)
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id])
  hiredAt      DateTime?
  specialties  String?
  notes        String?
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id])
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  // --- HR dossier (module RH) ---
  birthPlace           String?
  maritalStatus        MaritalStatus?
  photoPath            String?
  corpsId              String?
  corps                Corps?               @relation(fields: [corpsId], references: [id])
  administrativeStatus AdministrativeStatus @default(ACTIVE)
  serviceStartDate     DateTime?
  /// Date of taking up the current post (drives the 12-month rotation, phase 5).
  currentPostSince     DateTime?
  careerEvents         CareerEvent[]
  transferRequests     TransferRequest[]
  rotationExceptions   RotationException[]
  rotationAlerts       RotationAlert[]
  attendance           AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  skills               OfficerSkill[]
  disciplinaryCases    DisciplinaryCase[]
  distinctions         Distinction[]
  hrDocuments          HrDocument[]
  payElements          OfficerPayElement[]
  payLines             PayRunLine[]

  commandsStation     Station?            @relation("StationCommander")
  headsDepartment     Department?         @relation("DepartmentHead")
  assignments         OfficerAssignment[]
  arrests             Arrest[]
  patrolsSupervised   Patrol[]            @relation("PatrolSupervisor")
  patrolMembers       PatrolOfficer[]
  incidentOfficers    IncidentOfficer[]
  operationsCommanded Operation[]         @relation("OperationCommander")
  teamLeads           OperationTeam[]
  teamMembers         OperationMember[]
  vehicleAssignments  VehicleAssignment[]
  fuelLogs            FuelLog[]
  trainings           Training[]

  @@index([stationId])
  @@index([departmentId])
  @@index([lastName, firstName])
  @@index([currentPostSince])
}

model OfficerAssignment {
  id           String      @id @default(cuid())
  officerId    String
  officer      Officer     @relation(fields: [officerId], references: [id])
  stationId    String
  station      Station     @relation(fields: [stationId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  rankId       String?
  rank         Rank?       @relation(fields: [rankId], references: [id])
  position     String?
  positionId   String?
  positionRef  Position?   @relation(fields: [positionId], references: [id])
  startDate    DateTime
  endDate      DateTime?
  reason       String?
  createdById  String?
  createdBy    User?       @relation(fields: [createdById], references: [id])
  createdAt    DateTime    @default(now())

  @@index([officerId, startDate])
}

/// Corps of the Police nationale (referential, editable by HR administrators).
model Corps {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String
  isActive Boolean   @default(true)
  officers Officer[]
}

enum AdministrativeStatus {
  ACTIVE
  SECONDED
  AT_DISPOSAL
  SUSPENDED
  RETIRED
  CEASED
  DECEASED
}

enum CareerEventType {
  RECRUITMENT
  APPOINTMENT
  PROMOTION
  ADVANCEMENT
  FUNCTION_CHANGE
  TRANSFER
  SECONDMENT
  AT_DISPOSAL
  REINSTATEMENT
  RETIREMENT
  CESSATION
  SUSPENSION
}

/// Append-only career history of an officer (every change of grade, function, status or posting).
model CareerEvent {
  id             String                @id @default(cuid())
  officerId      String
  officer        Officer               @relation(fields: [officerId], references: [id])
  type           CareerEventType
  effectiveDate  DateTime
  reference      String
  reason         String?
  fromRankId     String?
  toRankId       String?
  fromPositionId String?
  toPositionId   String?
  fromStationId  String?
  toStationId    String?
  fromStatus     AdministrativeStatus?
  toStatus       AdministrativeStatus?
  recordedById   String?
  recordedBy     User?                 @relation(fields: [recordedById], references: [id])
  createdAt      DateTime              @default(now())

  @@index([officerId, effectiveDate])
  @@index([type, effectiveDate])
}

enum TransferStatus {
  PROPOSED
  HR_APPROVED
  APPROVED
  EXECUTED
  REJECTED
  CANCELLED
}

enum TransferOrigin {
  MANUAL
  AUTOMATIC
}

/// Posting change (mutation) going through the validation circuit: proposal -> HR review -> validation by the
/// competent authority -> decision -> execution on the dossier. Nothing moves an officer before APPROVED.
model TransferRequest {
  id               String         @id @default(cuid())
  number           String         @unique
  officerId        String
  officer          Officer        @relation(fields: [officerId], references: [id])
  fromStationId    String
  fromStation      Station        @relation("TransferFrom", fields: [fromStationId], references: [id])
  fromDepartmentId String?
  toStationId      String
  toStation        Station        @relation("TransferTo", fields: [toStationId], references: [id])
  toDepartmentId   String?
  toPositionId     String?
  effectiveDate    DateTime
  reason           String
  origin           TransferOrigin @default(MANUAL)
  status           TransferStatus @default(PROPOSED)
  proposedById     String?
  proposedBy       User?          @relation("TransferProposedBy", fields: [proposedById], references: [id])
  reviewedById     String?
  reviewedBy       User?          @relation("TransferReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  validatedById    String?
  validatedBy      User?          @relation("TransferValidatedBy", fields: [validatedById], references: [id])
  validatedAt      DateTime?
  validationNote   String?
  decisionNumber   String?        @unique
  executedAt       DateTime?
  closeReason      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([officerId])
  @@index([status, createdAt])
  @@index([fromStationId])
  @@index([toStationId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  PERMISSION
  UNAVAILABLE
}

/// One row per officer and day. LEAVE-derived rows (leaveId set) are generated by an approved leave and cannot be edited by roll-call.
model AttendanceRecord {
  id           String           @id @default(cuid())
  officerId    String
  officer      Officer          @relation(fields: [officerId], references: [id])
  stationId    String
  station      Station          @relation(fields: [stationId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  lateMinutes  Int?
  note         String?
  leaveId      String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([officerId, date])
  @@index([stationId, date])
  @@index([date, status])
}

enum LeaveType {
  ANNUAL
  EXCEPTIONAL
  PERMISSION
  ABSENCE_AUTHORIZATION
  UNAVAILABILITY
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

/// Leave, permission, authorised absence or unavailability: request -> approval by a hierarchical authority -> attendance generated.
model LeaveRequest {
  id            String      @id @default(cuid())
  number        String      @unique
  officerId     String
  officer       Officer     @relation(fields: [officerId], references: [id])
  stationId     String
  station       Station     @relation(fields: [stationId], references: [id])
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  days          Int
  reason        String?
  status        LeaveStatus @default(REQUESTED)
  requestedById String?
  requestedBy   User?       @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  decidedById   String?
  decidedBy     User?       @relation("LeaveDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([officerId, startDate])
  @@index([status, createdAt])
  @@index([stationId, status])
}

enum DisciplineStatus {
  OPEN
  IN_PROCEDURE
  DECIDED
  CLOSED
}

enum DisciplineStepKind {
  NOTIFICATION
  HEARING
  REPORT
  NOTE
}

enum SanctionKind {
  NO_ACTION
  WARNING
  REPRIMAND
  SUSPENSION
  DISMISSAL
}

/// Disciplinary procedure. Strictly confidential: every read is audited and needs hr:discipline_view.
model DisciplinaryCase {
  id             String             @id @default(cuid())
  number         String             @unique
  officerId      String
  officer        Officer            @relation(fields: [officerId], references: [id])
  stationId      String
  facts          String
  factsDate      DateTime           @db.Date
  status         DisciplineStatus   @default(OPEN)
  openedById     String?
  openedBy       User?              @relation("DisciplineOpenedBy", fields: [openedById], references: [id])
  sanction       SanctionKind?
  sanctionStart  DateTime?          @db.Date
  sanctionEnd    DateTime?          @db.Date
  sanctionActive Boolean            @default(false)
  decisionNumber String?            @unique
  decisionReason String?
  decidedById    String?
  decidedBy      User?              @relation("DisciplineDecidedBy", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  steps          DisciplinaryStep[]

  @@index([officerId])
  @@index([status])
  @@index([stationId])
}

model DisciplinaryStep {
  id           String             @id @default(cuid())
  caseId       String
  case         DisciplinaryCase   @relation(fields: [caseId], references: [id])
  kind         DisciplineStepKind
  date         DateTime           @db.Date
  note         String
  recordedById String?
  createdAt    DateTime           @default(now())

  @@index([caseId, date])
}

enum DistinctionKind {
  COMMENDATION
  CITATION
  MEDAL
  REWARD
}

model Distinction {
  id           String          @id @default(cuid())
  officerId    String
  officer      Officer         @relation(fields: [officerId], references: [id])
  kind         DistinctionKind
  title        String
  reason       String?
  reference    String?
  awardedAt    DateTime        @db.Date
  recordedById String?
  createdAt    DateTime        @default(now())

  @@index([officerId, awardedAt])
}

enum HrDocumentKind {
  ASSIGNMENT_DECISION
  APPOINTMENT_ORDER
  TRANSFER_DECISION
  WORK_CERTIFICATE
  TRAINING_DOCUMENT
  ADMIN_FILE
  DISCIPLINARY_DOCUMENT
  SERVICE_NOTE
}

enum HrDocumentSource {
  GENERATED
  UPLOADED
}

/// Central HR document space. GENERATED documents keep a frozen content snapshot (rendered to PDF or Word on demand);
/// UPLOADED ones keep the stored file. CONFIDENTIAL documents need hr:discipline_view.
model HrDocument {
  id           String           @id @default(cuid())
  number       String           @unique
  kind         HrDocumentKind
  title        String
  source       HrDocumentSource
  confidential Boolean          @default(false)
  officerId    String?
  officer      Officer?         @relation(fields: [officerId], references: [id])
  stationId    String?
  station      Station?         @relation(fields: [stationId], references: [id])
  relatedType  String?
  relatedId    String?
  snapshot     Json?
  storagePath  String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  sha256       String?
  createdById  String?
  createdBy    User?            @relation(fields: [createdById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([officerId, createdAt])
  @@index([kind, createdAt])
  @@index([stationId])
}

enum PayComponentKind {
  BONUS
  ALLOWANCE
  BENEFIT
  DEDUCTION
}

enum PayCalculation {
  FIXED
  PERCENT_OF_BASE
}

enum PayApprovalStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum PayRunStatus {
  DRAFT
  VALIDATED
}

/// Referential of pay elements other than the base salary: bonuses (primes), allowances (indemnités), benefits in kind
/// (avantages) and deductions (retenues). FIXED = FCFA per month; PERCENT_OF_BASE = whole percent of the base salary.
model PayComponent {
  id           String              @id @default(cuid())
  code         String              @unique
  name         String
  kind         PayComponentKind
  calculation  PayCalculation      @default(FIXED)
  defaultValue Int                 @default(0)
  description  String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  elements     OfficerPayElement[]
}

/// Base monthly salary (FCFA) of a rank from a date. Changes are requested then validated by someone else; history is kept.
model PayScaleEntry {
  id            String            @id @default(cuid())
  rankId        String
  rank          Rank              @relation(fields: [rankId], references: [id])
  amount        Int
  effectiveFrom DateTime          @db.Date
  status        PayApprovalStatus @default(PENDING)
  createdById   String?
  createdBy     User?             @relation("PayScaleCreatedBy", fields: [createdById], references: [id])
  validatedById String?
  validatedBy   User?             @relation("PayScaleValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?
  note          String?
  createdAt     DateTime          @default(now())

  @@unique([rankId, effectiveFrom])
  @@index([rankId, status, effectiveFrom])
}

/// A pay element granted to an officer for a period. Becomes effective only after validation by a person other than the requester.
model OfficerPayElement {
  id            String            @id @default(cuid())
  officerId     String
  officer       Officer           @relation(fields: [officerId], references: [id])
  componentId   String
  component     PayComponent      @relation(fields: [componentId], references: [id])
  value         Int?
  startDate     DateTime          @db.Date
  endDate       DateTime?         @db.Date
  status        PayApprovalStatus @default(PENDING)
  reason        String
  decisionRef   String?
  requestedById String?
  requestedBy   User?             @relation("PayElementRequestedBy", fields: [requestedById], references: [id])
  validatedById String?
  validatedBy   User?             @relation("PayElementValidatedBy", fields: [validatedById], references: [id])
  validatedAt   DateTime?
  note          String?
  endReason     String?
  createdAt     DateTime          @default(now())

  @@index([officerId, status])
  @@index([status, createdAt])
}

/// Monthly pay statement (état récapitulatif) of the whole force. Frozen once validated; it is a statement for the
/// financial services, the system never moves money.
model PayRun {
  id               String       @id @default(cuid())
  period           String       @unique
  status           PayRunStatus @default(DRAFT)
  generatedById    String?
  generatedBy      User?        @relation("PayRunGeneratedBy", fields: [generatedById], references: [id])
  validatedById    String?
  validatedBy      User?        @relation("PayRunValidatedBy", fields: [validatedById], references: [id])
  validatedAt      DateTime?
  exportedAt       DateTime?
  exportCount      Int          @default(0)
  officers         Int          @default(0)
  suspendedCount   Int          @default(0)
  excludedNoScale  Int          @default(0)
  excludedStatus   Int          @default(0)
  totalBase        BigInt       @default(0)
  totalGross       BigInt       @default(0)
  totalDeductions  BigInt       @default(0)
  totalNet         BigInt       @default(0)
  suspendedPercent Int          @default(100)
  createdAt        DateTime     @default(now())
  lines            PayRunLine[]
}

model PayRunLine {
  id         String               @id @default(cuid())
  runId      String
  run        PayRun               @relation(fields: [runId], references: [id], onDelete: Cascade)
  officerId  String
  officer    Officer              @relation(fields: [officerId], references: [id])
  rankId     String
  stationId  String
  regionId   String
  status     AdministrativeStatus
  base       Int
  gross      Int
  deductions Int
  net        Int
  detail     Json

  @@unique([runId, officerId])
  @@index([officerId])
  @@index([runId, rankId])
  @@index([runId, regionId])
}

/// Competence referential and the competences held by officers (granted by evaluated trainings).
model Skill {
  id       String         @id @default(cuid())
  code     String         @unique
  name     String
  isActive Boolean        @default(true)
  holders  OfficerSkill[]
}

model OfficerSkill {
  id         String    @id @default(cuid())
  officerId  String
  officer    Officer   @relation(fields: [officerId], references: [id])
  skillId    String
  skill      Skill     @relation(fields: [skillId], references: [id])
  level      Int
  acquiredAt DateTime
  expiresAt  DateTime?
  trainingId String?
  training   Training? @relation(fields: [trainingId], references: [id])

  @@unique([officerId, skillId])
}

/// Administrative exception: the officer is skipped by the automatic rotation while it is active.
model RotationException {
  id          String    @id @default(cuid())
  officerId   String
  officer     Officer   @relation(fields: [officerId], references: [id])
  reason      String
  startsAt    DateTime
  endsAt      DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  @@index([officerId])
}

enum RotationAlertKind {
  UPCOMING
  DUE
}

/// Idempotence ledger of the automatic rotation: one UPCOMING and one DUE alert per officer and post tenure.
model RotationAlert {
  id         String            @id @default(cuid())
  officerId  String
  officer    Officer           @relation(fields: [officerId], references: [id])
  kind       RotationAlertKind
  postSince  DateTime
  transferId String?
  createdAt  DateTime          @default(now())

  @@unique([officerId, postSince, kind])
  @@index([kind, createdAt])
}

/// Fonction (post/duty title) referential, e.g. Commissaire, Chef de service, Officier de police judiciaire.
model Position {
  id          String              @id @default(cuid())
  code        String              @unique
  name        String
  description String?
  isActive    Boolean             @default(true)
  assignments OfficerAssignment[]
  officers    Officer[]
}

enum TrainingStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum TrainingKind {
  INITIAL
  CONTINUING
  INTERNSHIP
  SPECIALIZED
}

/// Training / certification record of an officer.
model Training {
  id                  String         @id @default(cuid())
  officerId           String
  officer             Officer        @relation(fields: [officerId], references: [id])
  title               String
  provider            String?
  category            String?
  startDate           DateTime
  endDate             DateTime?
  status              TrainingStatus @default(PLANNED)
  result              String?
  certificateNo       String?
  expiresAt           DateTime?
  notes               String?
  recordedById        String?
  recordedBy          User?          @relation(fields: [recordedById], references: [id])
  kind                TrainingKind   @default(CONTINUING)
  score               Float?
  passed              Boolean?
  evaluatedAt         DateTime?
  certificateIssuedAt DateTime?
  skillsGranted       OfficerSkill[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([officerId, startDate])
  @@index([status])
}

// ------------------------------------------------------------
// 3. PERSONS
// ------------------------------------------------------------

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  UNKNOWN
}

model Person {
  id                  String        @id @default(cuid())
  number              String        @unique
  firstName           String
  lastName            String
  otherNames          String?
  gender              Gender        @default(UNKNOWN)
  dateOfBirth         DateTime?
  placeOfBirth        String?
  nationality         String?
  maritalStatus       MaritalStatus @default(UNKNOWN)
  occupation          String?
  phone               String?
  email               String?
  address             String?
  city                String?
  regionId            String?
  region              Region?       @relation(fields: [regionId], references: [id])
  stationId           String?
  station             Station?      @relation(fields: [stationId], references: [id])
  physicalDescription String?
  distinguishingMarks String?
  notes               String?
  isDeceased          Boolean       @default(false)
  createdById         String?
  createdBy           User?         @relation("PersonCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?
  mergedIntoId        String?
  mergedInto          Person?       @relation("PersonMerge", fields: [mergedIntoId], references: [id])
  mergedFrom          Person[]      @relation("PersonMerge")

  identifiers             PersonIdentifier[]
  aliases                 PersonAlias[]
  relationsFrom           PersonRelationship[]    @relation("RelFrom")
  relationsTo             PersonRelationship[]    @relation("RelTo")
  complaints              Complaint[]
  caseParties             CaseParty[]
  statements              Statement[]
  interviews              Interview[]
  evidenceFrom            Evidence[]
  warrants                Warrant[]
  arrests                 Arrest[]
  detentions              Detention[]
  wanted                  WantedPerson[]
  incidentPersons         IncidentPerson[]
  fingerprintRecords      FingerprintRecord[]
  faceRecords             FaceRecord[]
  voiceRecords            VoiceRecord[]
  plateDetections         LicensePlateDetection[]
  biometricMatches        BiometricMatch[]
  biometricTopMatches     BiometricSearch[]       @relation("BiometricTopMatch")
  trafficDriver           TrafficDriver?
  trafficVehiclesOwned    TrafficVehicle[]        @relation("TrafficVehicleOwner")
  trafficControlsAsDriver TrafficControl[]        @relation("TrafficControlDriver")
  trafficTicketsAsDriver  TrafficTicket[]         @relation("TrafficTicketDriver")
  trafficFinesAsDriver    TrafficFine[]           @relation("TrafficFineDriver")

  @@index([lastName, firstName])
  @@index([phone])
  @@index([dateOfBirth])
  @@index([regionId])
  @@index([stationId])
}

enum IdentifierType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  VOTER_CARD
  RESIDENCE_PERMIT
  BIRTH_CERTIFICATE
  OTHER
}

model PersonIdentifier {
  id        String         @id @default(cuid())
  personId  String
  person    Person         @relation(fields: [personId], references: [id])
  type      IdentifierType
  value     String
  issuedBy  String?
  issuedAt  DateTime?
  expiresAt DateTime?
  createdAt DateTime       @default(now())

  @@unique([type, value])
  @@index([personId])
}

model PersonAlias {
  id       String @id @default(cuid())
  personId String
  person   Person @relation(fields: [personId], references: [id])
  alias    String

  @@index([alias])
}

enum RelationshipType {
  SPOUSE
  PARENT
  CHILD
  SIBLING
  RELATIVE
  ASSOCIATE
  EMPLOYER
  EMPLOYEE
  NEIGHBOUR
  OTHER
}

model PersonRelationship {
  id           String           @id @default(cuid())
  fromPersonId String
  fromPerson   Person           @relation("RelFrom", fields: [fromPersonId], references: [id])
  toPersonId   String
  toPerson     Person           @relation("RelTo", fields: [toPersonId], references: [id])
  type         RelationshipType
  notes        String?
  createdAt    DateTime         @default(now())

  @@unique([fromPersonId, toPersonId, type])
}

enum DangerLevel {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum WantedStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  LOCATED
  ARRESTED
  CANCELLED
  EXPIRED
  SUSPENDED
}

/// Nature of the notice (cahier des charges SIGPN-T v2.0, section 4): a search warrant, a summons for a hearing, a missing person.
enum WantedKind {
  SEARCH_WARRANT
  HEARING
  MISSING_PERSON
}

model WantedPerson {
  id                  String       @id @default(cuid())
  number              String       @unique
  personId            String
  person              Person       @relation(fields: [personId], references: [id])
  caseId              String?
  case                Case?        @relation(fields: [caseId], references: [id])
  regionId            String
  region              Region       @relation(fields: [regionId], references: [id])
  stationId           String
  station             Station      @relation(fields: [stationId], references: [id])
  offense             String
  reason              String
  dangerLevel         DangerLevel  @default(MEDIUM)
  status              WantedStatus @default(DRAFT)
  lastSeenLocation    String?
  lastSeenAt          DateTime?
  warrantId           String?
  warrant             Warrant?     @relation(fields: [warrantId], references: [id])
  mainPhotoDocumentId String?      @unique
  mainPhoto           Document?    @relation("WantedMainPhoto", fields: [mainPhotoDocumentId], references: [id])
  issuedById          String
  issuedBy            User         @relation("WantedIssuedBy", fields: [issuedById], references: [id])
  approvedById        String?
  approvedBy          User?        @relation("WantedApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  issuedAt            DateTime     @default(now())
  expiresAt           DateTime?
  closedAt            DateTime?
  closureNotes        String?
  kind                WantedKind   @default(SEARCH_WARRANT)
  diffusionLevel      WantedDiffusion @default(NATIONAL)
  publicPublishedAt   DateTime?
  publicPublishedById String?
  publicNotice        String?
  legalBasis          String?
  issuingAuthority    String?
  verifiedById        String?
  verifiedBy          User?        @relation("WantedVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt          DateTime?
  verificationNotes   String?
  suspendedAt         DateTime?
  suspensionReason    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  sightings WantedSighting[]
  vehicles  WantedVehicle[]
  alerts    NationalAlert[]
  photos    Document[]       @relation("WantedPersonAttachment")

  @@index([status])
  @@index([personId])
  @@index([caseId])
  @@index([warrantId])
  @@index([stationId, status])
  @@index([regionId])
}

/// Location-sighting log (spec: location + date/time + source + officer + notes, latest cached on
/// WantedPerson.lastSeenLocation/lastSeenAt for quick display).
model WantedSighting {
  id             String       @id @default(cuid())
  wantedPersonId String
  wantedPerson   WantedPerson @relation(fields: [wantedPersonId], references: [id])
  location       String
  occurredAt     DateTime
  source         String?
  officerId      String
  officer        User         @relation(fields: [officerId], references: [id])
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([wantedPersonId, occurredAt])
}

/// A vehicle associated with a wanted person. Deliberately not the fleet Vehicle model (that is the
/// police's own fleet) and not the ANPR LicensePlateDetection table (out of scope for this feature).
model WantedVehicle {
  id             String       @id @default(cuid())
  wantedPersonId String
  wantedPerson   WantedPerson @relation(fields: [wantedPersonId], references: [id])
  plateNumber    String?
  make           String?
  model          String?
  color          String?
  year           Int?
  notes          String?
  addedById      String
  addedBy        User         @relation(fields: [addedById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([wantedPersonId])
}

// ------------------------------------------------------------
// 4. COMPLAINTS
// ------------------------------------------------------------

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OffenseCategory {
  HOMICIDE
  ASSAULT
  SEXUAL_OFFENSE
  ROBBERY
  THEFT
  BURGLARY
  FRAUD
  CORRUPTION
  DRUG_OFFENSE
  TRAFFICKING
  CYBERCRIME
  ARMS_OFFENSE
  KIDNAPPING
  DOMESTIC_VIOLENCE
  TRAFFIC_OFFENSE
  PUBLIC_ORDER
  PROPERTY_DAMAGE
  MISSING_PERSON
  TERRORISM
  OTHER
}

enum ComplaintStatus {
  DRAFT
  REGISTERED
  UNDER_REVIEW
  ASSIGNED
  CONVERTED
  CLOSED
  REJECTED
}

model Complaint {
  id            String          @id @default(cuid())
  number        String          @unique
  complainantId String?
  complainant   Person?         @relation(fields: [complainantId], references: [id])
  isAnonymous   Boolean         @default(false)
  category      OffenseCategory @default(OTHER)
  title         String
  description   String
  incidentAt    DateTime?
  receivedAt    DateTime        @default(now())
  locationText  String?
  regionId      String
  region        Region          @relation(fields: [regionId], references: [id])
  stationId     String
  station       Station         @relation(fields: [stationId], references: [id])
  priority      Priority        @default(NORMAL)
  status        ComplaintStatus @default(DRAFT)
  assignedToId  String?
  assignedTo    User?           @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])
  reviewedById  String?
  reviewedBy    User?           @relation("ComplaintReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNotes   String?
  closureReason String?
  closedAt      DateTime?
  caseId        String?         @unique
  case          Case?           @relation(fields: [caseId], references: [id])
  createdById   String
  createdBy     User            @relation("ComplaintCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  @@index([status])
  @@index([stationId, status])
  @@index([regionId])
  @@index([receivedAt])
}

// ------------------------------------------------------------
// 5. CASES
// ------------------------------------------------------------

enum CaseStatus {
  OPEN
  ASSIGNED
  UNDER_INVESTIGATION
  PENDING_REVIEW
  REFERRED
  CLOSED
  ARCHIVED
}

enum CaseDisposition {
  SOLVED
  UNSOLVED
  UNFOUNDED
  REFERRED_TO_PROSECUTION
  TRANSFERRED
  DISMISSED
}

model Case {
  id               String           @id @default(cuid())
  number           String           @unique
  title            String
  category         OffenseCategory
  description      String
  occurredAt       DateTime?
  reportedAt       DateTime         @default(now())
  locationText     String?
  regionId         String
  region           Region           @relation(fields: [regionId], references: [id])
  stationId        String
  station          Station          @relation(fields: [stationId], references: [id])
  departmentId     String?
  department       Department?      @relation(fields: [departmentId], references: [id])
  priority         Priority         @default(NORMAL)
  status           CaseStatus       @default(OPEN)
  isSensitive      Boolean          @default(false)
  leadId           String?
  lead             User?            @relation("CaseLead", fields: [leadId], references: [id])
  supervisorId     String?
  supervisor       User?            @relation("CaseSupervisor", fields: [supervisorId], references: [id])
  disposition      CaseDisposition?
  dispositionNotes String?
  closedAt         DateTime?
  archivedAt       DateTime?
  createdById      String
  createdBy        User             @relation("CaseCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  complaint              Complaint?
  assignments            CaseAssignment[]
  parties                CaseParty[]
  events                 CaseEvent[]
  notes                  CaseNote[]
  tasks                  Task[]
  investigations         Investigation[]
  reports                InvestigationReport[]
  statements             Statement[]
  interviews             Interview[]
  evidence               Evidence[]
  warrants               Warrant[]
  arrests                Arrest[]
  wanted                 WantedPerson[]
  incidents              Incident[]
  operations             Operation[]
  documents              Document[]
  biometricSearches      BiometricSearch[]
  licensePlateDetections LicensePlateDetection[]
  trafficControls        TrafficControl[]

  @@index([status])
  @@index([stationId, status])
  @@index([regionId])
  @@index([leadId])
  @@index([category])
  @@index([reportedAt])
}

enum CaseRole {
  LEAD
  INVESTIGATOR
  SUPERVISOR
  ANALYST
  SUPPORT
}

model CaseAssignment {
  id           String    @id @default(cuid())
  caseId       String
  case         Case      @relation(fields: [caseId], references: [id])
  userId       String
  user         User      @relation("CaseAssignmentUser", fields: [userId], references: [id])
  role         CaseRole  @default(INVESTIGATOR)
  assignedById String
  assignedBy   User      @relation("CaseAssignmentBy", fields: [assignedById], references: [id])
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?
  notes        String?

  @@index([caseId, endedAt])
  @@index([userId, endedAt])
}

enum PartyRole {
  COMPLAINANT
  VICTIM
  WITNESS
  SUSPECT
  PERSON_OF_INTEREST
  ACCUSED
  OTHER
}

/// Status of a person's involvement. A SUSPECT is never presumed guilty:
/// the default is UNDER_INVESTIGATION and only a competent authority can move it on.
enum PartyStatus {
  ACTIVE
  UNDER_INVESTIGATION
  CLEARED
  CHARGED
  REFERRED
  WITHDRAWN
}

model CaseParty {
  id        String      @id @default(cuid())
  caseId    String
  case      Case        @relation(fields: [caseId], references: [id])
  personId  String
  person    Person      @relation(fields: [personId], references: [id])
  role      PartyRole
  status    PartyStatus @default(ACTIVE)
  notes     String?
  injuries  String?
  addedById String?
  addedAt   DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([caseId, personId, role])
  @@index([personId])
  @@index([role])
}

model CaseEvent {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id])
  kind        String
  title       String
  description String?
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id])
  entityType  String?
  entityId    String?
  occurredAt  DateTime @default(now())

  @@index([caseId, occurredAt])
}

model CaseNote {
  id             String   @id @default(cuid())
  caseId         String
  case           Case     @relation(fields: [caseId], references: [id])
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  content        String
  isConfidential Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([caseId, createdAt])
}

// ------------------------------------------------------------
// 6. INVESTIGATION
// ------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

model Task {
  id              String         @id @default(cuid())
  caseId          String
  case            Case           @relation(fields: [caseId], references: [id])
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id])
  title           String
  description     String?
  priority        Priority       @default(NORMAL)
  status          TaskStatus     @default(TODO)
  assignedToId    String?
  assignedTo      User?          @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById     String
  createdBy       User           @relation("TaskCreator", fields: [createdById], references: [id])
  dueAt           DateTime?
  completedAt     DateTime?
  result          String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([caseId, status])
  @@index([assignedToId, status])
  @@index([dueAt])
}

enum InvestigationStatus {
  OPEN
  IN_PROGRESS
  REPORT_SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED
  CLOSED
}

model Investigation {
  id          String              @id @default(cuid())
  number      String              @unique
  caseId      String
  case        Case                @relation(fields: [caseId], references: [id])
  leadId      String
  lead        User                @relation("InvestigationLead", fields: [leadId], references: [id])
  status      InvestigationStatus @default(OPEN)
  openedAt    DateTime            @default(now())
  deadlineAt  DateTime?
  summary     String?
  findings    String?
  reviewerId  String?
  reviewer    User?               @relation("InvestigationReviewer", fields: [reviewerId], references: [id])
  reviewedAt  DateTime?
  reviewNotes String?
  closedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tasks   Task[]
  reports InvestigationReport[]

  @@index([caseId])
  @@index([status])
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  RETURNED
  SUPERSEDED
}

model InvestigationReport {
  id              String        @id @default(cuid())
  number          String        @unique
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id])
  caseId          String
  case            Case          @relation(fields: [caseId], references: [id])
  version         Int           @default(1)
  title           String
  content         String
  conclusions     String?
  recommendations String?
  status          ReportStatus  @default(DRAFT)
  authorId        String
  author          User          @relation("ReportAuthor", fields: [authorId], references: [id])
  submittedAt     DateTime?
  reviewerId      String?
  reviewer        User?         @relation("ReportReviewer", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([investigationId])
  @@index([caseId])
}

enum StatementType {
  WRITTEN
  ORAL_TRANSCRIBED
  SWORN
  CONFESSION
}

enum StatementStatus {
  DRAFT
  FINAL
  RETRACTED
}

model Statement {
  id             String          @id @default(cuid())
  number         String          @unique
  caseId         String
  case           Case            @relation(fields: [caseId], references: [id])
  personId       String
  person         Person          @relation(fields: [personId], references: [id])
  partyRole      PartyRole       @default(WITNESS)
  type           StatementType   @default(WRITTEN)
  status         StatementStatus @default(DRAFT)
  takenById      String
  takenBy        User            @relation(fields: [takenById], references: [id])
  takenAt        DateTime        @default(now())
  location       String?
  language       String?
  content        String
  isConfidential Boolean         @default(false)
  finalizedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transcripts    Transcript[]

  @@index([caseId])
  @@index([personId])
}

enum InterviewStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Interview {
  id            String          @id @default(cuid())
  number        String          @unique
  caseId        String
  case          Case            @relation(fields: [caseId], references: [id])
  personId      String
  person        Person          @relation(fields: [personId], references: [id])
  partyRole     PartyRole       @default(WITNESS)
  interviewerId String
  interviewer   User            @relation("InterviewLead", fields: [interviewerId], references: [id])
  scheduledAt   DateTime
  startedAt     DateTime?
  endedAt       DateTime?
  location      String?
  purpose       String?
  summary       String?
  status        InterviewStatus @default(SCHEDULED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  transcripts   Transcript[]

  @@index([caseId])
  @@index([personId])
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  AUTOMATED_DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// Speech-to-text output. Automated text is ALWAYS flagged as requiring human review.
model Transcript {
  id              String           @id @default(cuid())
  interviewId     String?
  interview       Interview?       @relation(fields: [interviewId], references: [id])
  statementId     String?
  statement       Statement?       @relation(fields: [statementId], references: [id])
  audioDocumentId String?          @unique
  audioDocument   Document?        @relation(fields: [audioDocumentId], references: [id])
  provider        String
  version         Int              @default(1)
  status          TranscriptStatus @default(PENDING)
  language        String?
  automatedText   String?
  reviewedText    String?
  segments        Json?
  durationSeconds Int?
  reviewerId      String?
  reviewer        User?            @relation("TranscriptReviewer", fields: [reviewerId], references: [id])
  reviewedAt      DateTime?
  approverId      String?
  approver        User?            @relation("TranscriptApprover", fields: [approverId], references: [id])
  approvedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([interviewId])
  @@index([statementId])
}

// ------------------------------------------------------------
// 7. EVIDENCE & CHAIN OF CUSTODY
// ------------------------------------------------------------

enum StorageLocationType {
  EVIDENCE_ROOM
  SAFE
  REFRIGERATED
  VEHICLE_LOT
  LABORATORY
  ARMORY
  EXTERNAL
}

model StorageLocation {
  id          String              @id @default(cuid())
  stationId   String
  station     Station             @relation(fields: [stationId], references: [id])
  code        String              @unique
  name        String
  type        StorageLocationType @default(EVIDENCE_ROOM)
  description String?
  isActive    Boolean             @default(true)
  evidence    Evidence[]
  custodyFrom CustodyEvent[]      @relation("CustodyFromLocation")
  custodyTo   CustodyEvent[]      @relation("CustodyToLocation")
}

enum EvidenceCategory {
  PHYSICAL
  DOCUMENT
  DIGITAL
  BIOLOGICAL
  WEAPON
  NARCOTICS
  VEHICLE
  CURRENCY
  AUDIO_VIDEO
  OTHER
}

enum EvidenceStatus {
  COLLECTED
  REGISTERED
  STORED
  TRANSFERRED
  UNDER_EXAMINATION
  RETURNED
  RELEASED
  DESTROYED
  ARCHIVED
}

model Evidence {
  id                    String           @id @default(cuid())
  number                String           @unique
  caseId                String
  case                  Case             @relation(fields: [caseId], references: [id])
  category              EvidenceCategory @default(PHYSICAL)
  description           String
  quantity              Decimal?         @db.Decimal(12, 3)
  unit                  String?
  sealNumber            String?
  collectedAt           DateTime
  collectedById         String
  collectedBy           User             @relation("EvidenceCollectedBy", fields: [collectedById], references: [id])
  collectedFrom         String?
  collectedFromPersonId String?
  collectedFromPerson   Person?          @relation(fields: [collectedFromPersonId], references: [id])
  condition             String?
  status                EvidenceStatus   @default(COLLECTED)
  currentCustodianId    String?
  currentCustodian      User?            @relation("EvidenceCustodian", fields: [currentCustodianId], references: [id])
  currentLocationId     String?
  currentLocation       StorageLocation? @relation(fields: [currentLocationId], references: [id])
  isSensitive           Boolean          @default(false)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  custody                CustodyEvent[]
  documents              Document[]
  fingerprintRecords     FingerprintRecord[]
  faceRecords            FaceRecord[]
  voiceRecords           VoiceRecord[]
  licensePlateDetections LicensePlateDetection[]

  @@index([caseId])
  @@index([status])
  @@index([currentCustodianId])
}

enum CustodyAction {
  COLLECTED
  REGISTERED
  STORED
  TRANSFERRED
  CHECKED_OUT
  CHECKED_IN
  EXAMINED
  RETURNED
  RELEASED
  DESTROYED
  ARCHIVED
}

/// Append-only chain of custody. Each row is hash-chained to the previous one.
model CustodyEvent {
  id             String           @id @default(cuid())
  evidenceId     String
  evidence       Evidence         @relation(fields: [evidenceId], references: [id])
  seq            Int
  action         CustodyAction
  fromUserId     String?
  fromUser       User?            @relation("CustodyFrom", fields: [fromUserId], references: [id])
  toUserId       String?
  toUser         User?            @relation("CustodyTo", fields: [toUserId], references: [id])
  fromLocationId String?
  fromLocation   StorageLocation? @relation("CustodyFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     StorageLocation? @relation("CustodyToLocation", fields: [toLocationId], references: [id])
  occurredAt     DateTime
  reason         String
  condition      String?
  notes          String?
  authorizedById String?
  authorizedBy   User?            @relation("CustodyAuthorizedBy", fields: [authorizedById], references: [id])
  recordedById   String
  recordedBy     User             @relation("CustodyRecordedBy", fields: [recordedById], references: [id])
  recordedAt     DateTime         @default(now())
  prevHash       String?
  hash           String

  @@unique([evidenceId, seq])
  @@index([evidenceId, occurredAt])
}

// ------------------------------------------------------------
// 8. WARRANTS, ARRESTS & DETENTION
// ------------------------------------------------------------

enum WarrantType {
  ARREST
  SEARCH
  DETENTION
  SUMMONS
  SEIZURE
  OTHER
}

enum WarrantStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  EXECUTED
  EXPIRED
  CANCELLED
  REJECTED
}

model Warrant {
  id                  String        @id @default(cuid())
  number              String        @unique
  type                WarrantType
  personId            String?
  person              Person?       @relation(fields: [personId], references: [id])
  caseId              String?
  case                Case?         @relation(fields: [caseId], references: [id])
  issuingAuthority    String
  issuingAuthorityRef String?
  grounds             String
  targetAddress       String?
  issuedAt            DateTime?
  expiresAt           DateTime?
  status              WarrantStatus @default(DRAFT)
  requestedById       String
  requestedBy         User          @relation("WarrantRequestedBy", fields: [requestedById], references: [id])
  approvedById        String?
  approvedBy          User?         @relation("WarrantApprovedBy", fields: [approvedById], references: [id])
  approvedAt          DateTime?
  decisionNotes       String?
  executedAt          DateTime?
  executedById        String?
  executedBy          User?         @relation("WarrantExecutedBy", fields: [executedById], references: [id])
  executionNotes      String?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  arrests       Arrest[]
  documents     Document[]
  wantedPersons WantedPerson[]

  @@index([status])
  @@index([expiresAt])
  @@index([personId])
  @@index([caseId])
}

enum ArrestAuthority {
  WARRANT
  FLAGRANTE_DELICTO
  COURT_ORDER
  PROBABLE_CAUSE
  OTHER
}

enum ArrestStatus {
  RECORDED
  IN_CUSTODY
  RELEASED
  TRANSFERRED
  CHARGED
}

model Arrest {
  id                 String          @id @default(cuid())
  number             String          @unique
  personId           String
  person             Person          @relation(fields: [personId], references: [id])
  caseId             String?
  case               Case?           @relation(fields: [caseId], references: [id])
  warrantId          String?
  warrant            Warrant?        @relation(fields: [warrantId], references: [id])
  arrestingOfficerId String
  arrestingOfficer   Officer         @relation(fields: [arrestingOfficerId], references: [id])
  stationId          String
  station            Station         @relation(fields: [stationId], references: [id])
  arrestedAt         DateTime
  locationText       String
  authority          ArrestAuthority @default(FLAGRANTE_DELICTO)
  charges            String
  circumstances      String?
  rightsReadAt       DateTime?
  status             ArrestStatus    @default(RECORDED)
  notes              String?
  recordedById       String
  recordedBy         User            @relation(fields: [recordedById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  detentions Detention[]
  documents  Document[]

  @@index([personId])
  @@index([caseId])
  @@index([stationId, arrestedAt])
  @@index([status])
}

enum DetentionStatus {
  ACTIVE
  EXTENDED
  ENDED
}

enum DetentionEndReason {
  RELEASED_NO_CHARGE
  RELEASED_ON_BAIL
  TRANSFERRED_PROSECUTION
  TRANSFERRED_STATION
  COURT_APPEARANCE
  MEDICAL
  OTHER
}

model Detention {
  id                 String              @id @default(cuid())
  number             String              @unique
  arrestId           String
  arrest             Arrest              @relation(fields: [arrestId], references: [id])
  personId           String
  person             Person              @relation(fields: [personId], references: [id])
  stationId          String
  station            Station             @relation(fields: [stationId], references: [id])
  cellNumber         String?
  startedAt          DateTime
  legalLimitAt       DateTime
  extendedUntil      DateTime?
  extensionAuthority String?
  extensionReason    String?
  status             DetentionStatus     @default(ACTIVE)
  endedAt            DateTime?
  endReason          DetentionEndReason?
  endNotes           String?
  medicalNotes       String?
  recordedById       String
  recordedBy         User                @relation(fields: [recordedById], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  logs               DetentionLog[]

  @@index([status])
  @@index([stationId, status])
  @@index([legalLimitAt])
}

enum DetentionLogType {
  WELFARE_CHECK
  MEAL
  MEDICAL
  VISIT
  LEGAL_COUNSEL
  TRANSFER
  INCIDENT
  NOTE
}

model DetentionLog {
  id           String           @id @default(cuid())
  detentionId  String
  detention    Detention        @relation(fields: [detentionId], references: [id])
  type         DetentionLogType
  notes        String
  occurredAt   DateTime         @default(now())
  recordedById String
  recordedBy   User             @relation(fields: [recordedById], references: [id])

  @@index([detentionId, occurredAt])
}

// ------------------------------------------------------------
// 9. OPERATIONS: PATROLS, INCIDENTS, OPERATIONS
// ------------------------------------------------------------

model Zone {
  id          String   @id @default(cuid())
  stationId   String
  station     Station  @relation(fields: [stationId], references: [id])
  code        String
  name        String
  description String?
  isActive    Boolean  @default(true)
  patrols     Patrol[]

  @@unique([stationId, code])
}

enum Shift {
  MORNING
  AFTERNOON
  NIGHT
  CUSTOM
}

enum PatrolStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Patrol {
  id           String       @id @default(cuid())
  number       String       @unique
  stationId    String
  station      Station      @relation(fields: [stationId], references: [id])
  zoneId       String?
  zone         Zone?        @relation(fields: [zoneId], references: [id])
  shift        Shift        @default(MORNING)
  mission      String
  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?
  status       PatrolStatus @default(PLANNED)
  supervisorId String
  supervisor   Officer      @relation("PatrolSupervisor", fields: [supervisorId], references: [id])
  vehicleId    String?
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id])
  startKm      Int?
  endKm        Int?
  report       String?
  notes        String?
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  officers  PatrolOfficer[]
  incidents Incident[]

  @@index([stationId, status])
  @@index([plannedStart])
}

model PatrolOfficer {
  patrolId  String
  patrol    Patrol  @relation(fields: [patrolId], references: [id])
  officerId String
  officer   Officer @relation(fields: [officerId], references: [id])
  role      String?

  @@id([patrolId, officerId])
}

enum IncidentType {
  DISTURBANCE
  TRAFFIC_ACCIDENT
  ASSAULT
  THEFT
  FIRE
  MEDICAL
  SUSPICIOUS_ACTIVITY
  PUBLIC_ORDER
  DOMESTIC
  NOISE
  MISSING_PERSON
  OTHER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  REPORTED
  RESPONDING
  ON_SCENE
  RESOLVED
  ESCALATED
  CLOSED
}

model Incident {
  id           String         @id @default(cuid())
  number       String         @unique
  type         IncidentType   @default(OTHER)
  severity     Severity       @default(MEDIUM)
  title        String
  description  String
  occurredAt   DateTime
  reportedAt   DateTime       @default(now())
  locationText String
  latitude     Float?
  longitude    Float?
  regionId     String
  region       Region         @relation(fields: [regionId], references: [id])
  stationId    String
  station      Station        @relation(fields: [stationId], references: [id])
  status       IncidentStatus @default(REPORTED)
  caseId       String?
  case         Case?          @relation(fields: [caseId], references: [id])
  patrolId     String?
  patrol       Patrol?        @relation(fields: [patrolId], references: [id])
  report       String?
  resolvedAt   DateTime?
  reportedById String
  reportedBy   User           @relation(fields: [reportedById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  officers        IncidentOfficer[]
  persons         IncidentPerson[]
  documents       Document[]
  trafficControls TrafficControl[]

  @@index([stationId, status])
  @@index([occurredAt])
  @@index([severity])
}

model IncidentOfficer {
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  officerId  String
  officer    Officer  @relation(fields: [officerId], references: [id])
  role       String?

  @@id([incidentId, officerId])
}

model IncidentPerson {
  incidentId String
  incident   Incident  @relation(fields: [incidentId], references: [id])
  personId   String
  person     Person    @relation(fields: [personId], references: [id])
  role       PartyRole @default(OTHER)
  notes      String?

  @@id([incidentId, personId])
}

enum OperationType {
  RAID
  CHECKPOINT
  SURVEILLANCE
  ESCORT
  CROWD_CONTROL
  SEARCH
  JOINT
  OTHER
}

enum OperationStatus {
  PLANNED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Operation {
  id           String          @id @default(cuid())
  number       String          @unique
  name         String
  type         OperationType   @default(OTHER)
  objective    String
  plan         String?
  riskLevel    Severity        @default(MEDIUM)
  regionId     String
  region       Region          @relation(fields: [regionId], references: [id])
  stationId    String
  station      Station         @relation(fields: [stationId], references: [id])
  commanderId  String
  commander    Officer         @relation("OperationCommander", fields: [commanderId], references: [id])
  caseId       String?
  case         Case?           @relation(fields: [caseId], references: [id])
  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?
  status       OperationStatus @default(PLANNED)
  finalReport  String?
  outcome      String?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  teams     OperationTeam[]
  resources OperationResource[]
  documents Document[]

  @@index([stationId, status])
  @@index([plannedStart])
}

model OperationTeam {
  id          String            @id @default(cuid())
  operationId String
  operation   Operation         @relation(fields: [operationId], references: [id])
  name        String
  leaderId    String?
  leader      Officer?          @relation(fields: [leaderId], references: [id])
  mission     String?
  members     OperationMember[]
}

model OperationMember {
  teamId    String
  team      OperationTeam @relation(fields: [teamId], references: [id])
  officerId String
  officer   Officer       @relation(fields: [officerId], references: [id])
  role      String?

  @@id([teamId, officerId])
}

model OperationResource {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  description String
  quantity    Int       @default(1)
}

// ------------------------------------------------------------
// 10. FLEET
// ------------------------------------------------------------

enum VehicleType {
  PATROL_CAR
  MOTORCYCLE
  VAN
  PICKUP
  TRUCK
  BUS
  UNMARKED
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

model Vehicle {
  id                 String        @id @default(cuid())
  fleetNumber        String        @unique
  plateNumber        String        @unique
  vin                String?       @unique
  make               String
  model              String
  year               Int?
  color              String?
  type               VehicleType   @default(PATROL_CAR)
  fuelType           FuelType      @default(PETROL)
  stationId          String
  station            Station       @relation(fields: [stationId], references: [id])
  status             VehicleStatus @default(AVAILABLE)
  mileageKm          Int           @default(0)
  acquiredAt         DateTime?
  insuranceExpiresAt DateTime?
  inspectionDueAt    DateTime?
  notes              String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  assignments VehicleAssignment[]
  maintenance MaintenanceRecord[]
  fuelLogs    FuelLog[]
  patrols     Patrol[]
  opResources OperationResource[]
  documents   Document[]

  @@index([stationId, status])
}

model VehicleAssignment {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id])
  officerId String?
  officer   Officer?  @relation(fields: [officerId], references: [id])
  purpose   String
  startAt   DateTime
  endAt     DateTime?
  startKm   Int?
  endKm     Int?
  notes     String?
  createdAt DateTime  @default(now())

  @@index([vehicleId, startAt])
}

enum MaintenanceType {
  SERVICE
  REPAIR
  INSPECTION
  TIRES
  BODYWORK
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceRecord {
  id           String            @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id])
  type         MaintenanceType   @default(SERVICE)
  status       MaintenanceStatus @default(SCHEDULED)
  description  String
  scheduledAt  DateTime
  performedAt  DateTime?
  mileageKm    Int?
  cost         Decimal?          @db.Decimal(12, 2)
  provider     String?
  nextDueAt    DateTime?
  nextDueKm    Int?
  recordedById String
  recordedBy   User              @relation(fields: [recordedById], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([vehicleId, scheduledAt])
  @@index([status])
}

model FuelLog {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id])
  officerId    String?
  officer      Officer? @relation(fields: [officerId], references: [id])
  filledAt     DateTime @default(now())
  liters       Decimal  @db.Decimal(10, 2)
  cost         Decimal? @db.Decimal(12, 2)
  mileageKm    Int?
  station      String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])

  @@index([vehicleId, filledAt])
}

// ------------------------------------------------------------
// 11. DOCUMENTS, REPORTS, NOTIFICATIONS
// ------------------------------------------------------------

enum DocumentEntity {
  CASE
  COMPLAINT
  EVIDENCE
  PERSON
  ARREST
  WARRANT
  INCIDENT
  PATROL
  OPERATION
  VEHICLE
  OFFICER
  STATEMENT
  INTERVIEW
  INVESTIGATION
  REPORT
  WANTED_PERSON
  TRAFFIC_CONTROL
  TRAFFIC_TICKET
  TRAFFIC_DRIVER
  TRAFFIC_VEHICLE
  TRAFFIC_DEPOSIT
  GENERAL
}

enum DocumentCategory {
  PHOTO
  SCAN
  FORM
  REPORT
  AUDIO
  VIDEO
  IDENTITY
  LEGAL
  OTHER
}

enum Classification {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
  SECRET
}

model Document {
  id             String           @id @default(cuid())
  title          String
  entityType     DocumentEntity
  entityId       String?
  category       DocumentCategory @default(OTHER)
  classification Classification   @default(INTERNAL)
  description    String?
  currentVersion Int              @default(1)
  uploadedById   String
  uploadedBy     User             @relation(fields: [uploadedById], references: [id])
  stationId      String?
  station        Station?         @relation(fields: [stationId], references: [id])
  caseId         String?
  case           Case?            @relation(fields: [caseId], references: [id])
  evidenceId     String?
  evidence       Evidence?        @relation(fields: [evidenceId], references: [id])
  warrantId      String?
  warrant        Warrant?         @relation(fields: [warrantId], references: [id])
  arrestId       String?
  arrest         Arrest?          @relation(fields: [arrestId], references: [id])
  incidentId     String?
  incident       Incident?        @relation(fields: [incidentId], references: [id])
  operationId    String?
  operation      Operation?       @relation(fields: [operationId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?         @relation(fields: [vehicleId], references: [id])
  wantedPersonId String?
  wantedPerson   WantedPerson?    @relation("WantedPersonAttachment", fields: [wantedPersonId], references: [id])
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  versions               DocumentVersion[]
  transcript             Transcript?
  generated              GeneratedReport?
  mainPhotoOfWanted      WantedPerson?           @relation("WantedMainPhoto")
  trafficDriverPhoto     TrafficDriver?          @relation("TrafficDriverPhoto")
  trafficEvidence        TrafficEvidence?
  cashDeposit            TrafficDeposit?
  cashDiscrepancy        TrafficCashDiscrepancy?
  trafficVehicleDocument TrafficVehicleDocument?

  @@index([entityType, entityId])
  @@index([caseId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  version      Int
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  sha256       String
  changeNote   String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@unique([documentId, version])
}

enum ReportType {
  CASE
  INVESTIGATION
  ARREST
  EVIDENCE
  INCIDENT
  PATROL
  STATION
  STATISTICAL
}

model GeneratedReport {
  id            String     @id @default(cuid())
  number        String     @unique
  type          ReportType
  title         String
  parameters    Json?
  entityId      String?
  generatedById String
  generatedBy   User       @relation(fields: [generatedById], references: [id])
  generatedAt   DateTime   @default(now())
  documentId    String?    @unique
  document      Document?  @relation(fields: [documentId], references: [id])

  @@index([type, generatedAt])
}

enum NotificationKind {
  INFO
  ASSIGNMENT
  DEADLINE
  APPROVAL
  ALERT
  SECURITY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(INFO)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// ------------------------------------------------------------
// 12. AUDIT, SYSTEM, BACKUP
// ------------------------------------------------------------

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Immutable audit log (DB trigger forbids UPDATE/DELETE).
model AuditLog {
  id          String       @id @default(cuid())
  at          DateTime     @default(now())
  actorId     String?
  actor       User?        @relation(fields: [actorId], references: [id])
  actorLabel  String
  action      String
  module      String
  entityType  String?
  entityId    String?
  entityLabel String?
  summary     String
  before      Json?
  after       Json?
  outcome     AuditOutcome @default(SUCCESS)
  ipAddress   String?
  userAgent   String?
  sessionId   String?

  @@index([at])
  @@index([actorId, at])
  @@index([entityType, entityId])
  @@index([module, action])
}

model DocumentSequence {
  key    String @id
  prefix String
  width  Int    @default(5)
  next   Int    @default(1)
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

enum BackupStatus {
  RUNNING
  COMPLETED
  FAILED
  RESTORED
}

model BackupRecord {
  id            String       @id @default(cuid())
  type          String       @default("FULL")
  status        BackupStatus @default(RUNNING)
  fileName      String?
  sizeBytes     Int?
  sha256        String?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  notes         String?
  triggeredById String?
  triggeredBy   User?        @relation(fields: [triggeredById], references: [id])
}

// ------------------------------------------------------------
// 13. BIOMETRIC & FORENSIC IDENTIFICATION
// ------------------------------------------------------------

enum BiometricType {
  FINGERPRINT
  FACE
  VOICE
  ANPR
}

enum BiometricSearchMode {
  VERIFY_1_1
  IDENTIFY_1_N
}

enum BiometricSearchResult {
  NO_MATCH
  POTENTIAL_MATCH
  VERIFIED_MATCH
  ERROR
}

enum BiometricAction {
  NONE
  SENT_FOR_VERIFICATION
  VERIFIED_BY_INVESTIGATOR
  REJECTED
  LINKED_TO_CASE
}

enum FingerPosition {
  RIGHT_THUMB
  RIGHT_INDEX
  RIGHT_MIDDLE
  RIGHT_RING
  RIGHT_LITTLE
  LEFT_THUMB
  LEFT_INDEX
  LEFT_MIDDLE
  LEFT_RING
  LEFT_LITTLE
  UNKNOWN
}

enum LprStatus {
  NEW
  REVIEWED
  LINKED_TO_CASE
  DISMISSED
}

/// Encrypted biometric template (never a raw image). The optional source capture, if retained, is a
/// normal Evidence row (hash, chain of custody) — biometric tables never hold file bytes themselves.
model FingerprintRecord {
  id                String         @id @default(cuid())
  number            String         @unique
  personId          String
  person            Person         @relation(fields: [personId], references: [id])
  position          FingerPosition @default(UNKNOWN)
  templateSecretEnc String
  quality           Int?
  device            String?
  sourceEvidenceId  String?
  sourceEvidence    Evidence?      @relation(fields: [sourceEvidenceId], references: [id])
  capturedById      String
  capturedBy        User           @relation("BiometricCapturedBy", fields: [capturedById], references: [id])
  capturedAt        DateTime       @default(now())
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([personId])
}

model FaceRecord {
  id                String    @id @default(cuid())
  number            String    @unique
  personId          String
  person            Person    @relation(fields: [personId], references: [id])
  templateSecretEnc String
  quality           Int?
  device            String?
  sourceEvidenceId  String?
  sourceEvidence    Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  capturedById      String
  capturedBy        User      @relation("BiometricCapturedBy", fields: [capturedById], references: [id])
  capturedAt        DateTime  @default(now())
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([personId])
}

model VoiceRecord {
  id                String    @id @default(cuid())
  number            String    @unique
  personId          String
  person            Person    @relation(fields: [personId], references: [id])
  templateSecretEnc String
  durationSeconds   Int?
  device            String?
  sourceEvidenceId  String?
  sourceEvidence    Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  capturedById      String
  capturedBy        User      @relation("BiometricCapturedBy", fields: [capturedById], references: [id])
  capturedAt        DateTime  @default(now())
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([personId])
}

/// One row per plate-read event. A plate's "vehicle profile" is derived by querying all rows for
/// the same plateNumber (most recent first) — deliberately not a master vehicle table (see Vehicle,
/// which is the internal fleet, not a civilian/suspect vehicle registry).
model LicensePlateDetection {
  id               String    @id @default(cuid())
  number           String    @unique
  plateNumber      String
  vehicleMake      String?
  vehicleModel     String?
  vehicleColor     String?
  cameraId         String?
  locationText     String?
  latitude         Float?
  longitude        Float?
  detectedAt       DateTime
  caseId           String?
  case             Case?     @relation(fields: [caseId], references: [id])
  personId         String?
  person           Person?   @relation(fields: [personId], references: [id])
  sourceEvidenceId String?
  sourceEvidence   Evidence? @relation(fields: [sourceEvidenceId], references: [id])
  status           LprStatus @default(NEW)
  recordedById     String
  recordedBy       User      @relation(fields: [recordedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([plateNumber])
  @@index([caseId])
  @@index([detectedAt])
}

/// The mandatory audit/history record for every biometric search (spec: no anonymous search, case +
/// reason + officer + type required). Core fields are write-once; only recordBiometricAction() may
/// later touch action/actionNotes/actionById/actionAt. No delete path exists anywhere in the app.
model BiometricSearch {
  id               String                @id @default(cuid())
  number           String                @unique
  type             BiometricType
  mode             BiometricSearchMode
  caseId           String
  case             Case                  @relation(fields: [caseId], references: [id])
  reason           String
  officerId        String
  officer          User                  @relation("BiometricSearchOfficer", fields: [officerId], references: [id])
  device           String?
  location         String?
  parameters       Json?
  resultCount      Int                   @default(0)
  result           BiometricSearchResult @default(NO_MATCH)
  topMatchScore    Decimal?              @db.Decimal(5, 2)
  topMatchPersonId String?
  topMatchPerson   Person?               @relation("BiometricTopMatch", fields: [topMatchPersonId], references: [id])
  action           BiometricAction       @default(NONE)
  actionNotes      String?
  actionById       String?
  actionBy         User?                 @relation("BiometricSearchActionBy", fields: [actionById], references: [id])
  actionAt         DateTime?
  isDemo           Boolean               @default(true)
  ipAddress        String?
  createdAt        DateTime              @default(now())

  matches BiometricMatch[]

  @@index([caseId])
  @@index([type])
  @@index([officerId])
  @@index([createdAt])
}

model BiometricMatch {
  id          String          @id @default(cuid())
  searchId    String
  search      BiometricSearch @relation(fields: [searchId], references: [id])
  personId    String?
  person      Person?         @relation(fields: [personId], references: [id])
  score       Decimal         @db.Decimal(5, 2)
  sourceLabel String
  rank        Int
  createdAt   DateTime        @default(now())

  @@unique([searchId, rank])
  @@index([searchId])
}

// ------------------------------------------------------------
// 14. TRAFFIC OFFENCES AND FINES (Gestion des infractions routières et des amendes)
// ------------------------------------------------------------

enum TrafficOffenceClass {
  CLASS_2
  CLASS_3
  CLASS_4
  DELIT
}

enum TrafficVehicleType {
  CAR
  PICKUP
  MOTORCYCLE
  MOTO_TAXI
  TRICYCLE
  CYCLE
  MINIBUS
  BUS
  TRUCK
  TRACTOR_TRAILER
  OTHER
}

enum TrafficVehicleStatus {
  ACTIVE
  SUSPENDED
  SEIZED
  STOLEN
  SCRAPPED
}

enum TrafficVehicleDocType {
  REGISTRATION_CARD
  INSURANCE
  TECHNICAL_INSPECTION
  BLUE_CARD
  TRANSPORT_LICENSE
  STICKER
  OTHER
}

enum TrafficControlOutcome {
  COMPLIANT
  INFRACTION
}

enum TrafficTicketStatus {
  ISSUED
  CANCELLED
}

enum TrafficFineStatus {
  PENDING
  TO_PAY
  PARTIALLY_PAID
  PAID
  CONTESTED
  CANCELLED
}

enum TrafficPaymentMethod {
  CASH
  ELECTRONIC
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum TrafficPaymentStatus {
  COMPLETED
  VOIDED
}

enum TrafficEvidenceKind {
  PHOTO
  VIDEO
  DOCUMENT
}

/// The three parts of the official offence table: A road offences, B cycles & motorcycles, C moto-taxis.
model TrafficViolationCategory {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  sourceHeading String?
  sortOrder     Int
  createdAt     DateTime @default(now())

  violations TrafficViolation[]
}

/// Legal text of an offence, copied verbatim from the source table (several offences may share one).
model TrafficLegalReference {
  id        String   @id @default(cuid())
  reference String   @unique
  createdAt DateTime @default(now())

  violations TrafficViolation[]
}

/// Offence catalogue imported verbatim from the official table (name, class, legal text, flat fine).
/// `fineAmountFcfa` is null for a « Délit » (the source states « Interdiction d'arbitrer » instead of an amount).
model TrafficViolation {
  id               String                   @id @default(cuid())
  code             String                   @unique
  categoryId       String
  category         TrafficViolationCategory @relation(fields: [categoryId], references: [id])
  legalReferenceId String
  legalReference   TrafficLegalReference    @relation(fields: [legalReferenceId], references: [id])
  name             String
  offenceClass     TrafficOffenceClass
  classText        String
  fineAmountFcfa   Int?
  fineAmountText   String
  isFineEligible   Boolean
  sourcePage       Int
  sourceOrder      Int                      @unique
  sourceNote       String?
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  ticketOffences TrafficTicketOffence[]

  @@index([categoryId])
  @@index([offenceClass])
  @@index([name])
}

/// Driver profile of a Person (identity, phone and address stay on Person; the CNI is a PersonIdentifier).
model TrafficDriver {
  id               String    @id @default(cuid())
  personId         String    @unique
  person           Person    @relation(fields: [personId], references: [id])
  licenseNumber    String?   @unique
  licenseCategory  String?
  licenseIssuedAt  DateTime?
  licenseExpiresAt DateTime?
  licenseIssuedBy  String?
  photoDocumentId  String?   @unique
  photo            Document? @relation("TrafficDriverPhoto", fields: [photoDocumentId], references: [id])
  notes            String?
  createdById      String
  createdBy        User      @relation("TrafficDriverCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  controls TrafficControl[]
}

/// Civilian / commercial vehicle registry (the fleet `Vehicle` model is the police's own vehicles).
model TrafficVehicle {
  id                           String               @id @default(cuid())
  plateNumber                  String               @unique
  registrationCardNumber       String?              @unique
  make                         String?
  model                        String?
  color                        String?
  vehicleType                  TrafficVehicleType   @default(CAR)
  year                         Int?
  ownerPersonId                String?
  owner                        Person?              @relation("TrafficVehicleOwner", fields: [ownerPersonId], references: [id])
  chassisNumber                String?              @unique
  insuranceCompany             String?
  insurancePolicyNumber        String?
  insuranceExpiresAt           DateTime?
  technicalInspectionExpiresAt DateTime?
  status                       TrafficVehicleStatus @default(ACTIVE)
  notes                        String?
  createdById                  String
  createdBy                    User                 @relation("TrafficVehicleCreatedBy", fields: [createdById], references: [id])
  createdAt                    DateTime             @default(now())
  updatedAt                    DateTime             @updatedAt

  documents TrafficVehicleDocument[]
  controls  TrafficControl[]

  @@index([ownerPersonId])
}

model TrafficVehicleDocument {
  id         String                @id @default(cuid())
  vehicleId  String
  vehicle    TrafficVehicle        @relation(fields: [vehicleId], references: [id])
  type       TrafficVehicleDocType
  number     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  documentId String?               @unique
  document   Document?             @relation(fields: [documentId], references: [id])
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([vehicleId, type])
}

/// A roadside control by an officer. May end without offence (COMPLIANT) or lead to one PV (ticket).
model TrafficControl {
  id             String                @id @default(cuid())
  number         String                @unique
  controlledAt   DateTime
  location       String
  latitude       Float?
  longitude      Float?
  stationId      String
  station        Station               @relation(fields: [stationId], references: [id])
  regionId       String
  region         Region                @relation(fields: [regionId], references: [id])
  officerId      String
  officer        User                  @relation("TrafficControlOfficer", fields: [officerId], references: [id])
  driverPersonId String?
  driverPerson   Person?               @relation("TrafficControlDriver", fields: [driverPersonId], references: [id])
  driverId       String?
  driver         TrafficDriver?        @relation(fields: [driverId], references: [id])
  licenseNumber  String?
  vehicleId      String?
  vehicle        TrafficVehicle?       @relation(fields: [vehicleId], references: [id])
  plateNumber    String?
  vehicleType    TrafficVehicleType    @default(CAR)
  vehicleMake    String?
  vehicleColor   String?
  outcome        TrafficControlOutcome @default(COMPLIANT)
  observations   String?
  caseId         String?
  case           Case?                 @relation(fields: [caseId], references: [id])
  incidentId     String?
  incident       Incident?             @relation(fields: [incidentId], references: [id])
  isDemo         Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  ticket   TrafficTicket?
  evidence TrafficEvidence[]

  @@index([stationId, controlledAt])
  @@index([regionId, controlledAt])
  @@index([officerId, controlledAt])
  @@index([controlledAt])
  @@index([plateNumber])
  @@index([driverPersonId])
}

/// Procès-verbal électronique. Offence lines are snapshots of the catalogue at issue time;
/// `contentHash`/`signature` seal the content (tamper evidence) and `verificationToken` feeds the public QR check.
model TrafficTicket {
  id                      String              @id @default(cuid())
  number                  String              @unique
  verificationToken       String              @unique
  controlId               String              @unique
  control                 TrafficControl      @relation(fields: [controlId], references: [id])
  status                  TrafficTicketStatus @default(ISSUED)
  issuedAt                DateTime            @default(now())
  stationId               String
  station                 Station             @relation(fields: [stationId], references: [id])
  regionId                String
  region                  Region              @relation(fields: [regionId], references: [id])
  issuedById              String
  issuedBy                User                @relation("TrafficTicketIssuedBy", fields: [issuedById], references: [id])
  driverPersonId          String?
  driverPerson            Person?             @relation("TrafficTicketDriver", fields: [driverPersonId], references: [id])
  plateNumber             String?
  totalFineFcfa           Int
  hasNonSettleableOffence Boolean             @default(false)
  observations            String?
  contentHash             String
  signature               String
  signedAt                DateTime            @default(now())
  cancelledAt             DateTime?
  cancelledById           String?
  cancelledBy             User?               @relation("TrafficTicketCancelledBy", fields: [cancelledById], references: [id])
  cancellationReason      String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  offences TrafficTicketOffence[]
  fine     TrafficFine?

  @@index([stationId, issuedAt])
  @@index([regionId, issuedAt])
  @@index([issuedById, issuedAt])
  @@index([plateNumber])
  @@index([driverPersonId])
}

model TrafficTicketOffence {
  id             String           @id @default(cuid())
  ticketId       String
  ticket         TrafficTicket    @relation(fields: [ticketId], references: [id])
  violationId    String
  violation      TrafficViolation @relation(fields: [violationId], references: [id])
  code           String
  name           String
  classText      String
  legalReference String
  amountFcfa     Int?
  amountText     String
  createdAt      DateTime         @default(now())

  @@unique([ticketId, violationId])
  @@index([violationId])
}

model TrafficFine {
  id             String            @id @default(cuid())
  number         String            @unique
  ticketId       String            @unique
  ticket         TrafficTicket     @relation(fields: [ticketId], references: [id])
  status         TrafficFineStatus @default(TO_PAY)
  amountFcfa     Int
  amountPaidFcfa Int               @default(0)
  issuedAt       DateTime          @default(now())
  dueDate        DateTime?
  paidAt         DateTime?
  driverPersonId String?
  driverPerson   Person?           @relation("TrafficFineDriver", fields: [driverPersonId], references: [id])
  plateNumber    String?
  officerId      String
  officer        User              @relation("TrafficFineOfficer", fields: [officerId], references: [id])
  stationId      String
  station        Station           @relation(fields: [stationId], references: [id])
  regionId       String
  region         Region            @relation(fields: [regionId], references: [id])
  contestedAt    DateTime?
  contestReason  String?
  statusNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  payments TrafficPayment[]
  receipts TrafficReceipt[]

  @@index([status])
  @@index([stationId, issuedAt])
  @@index([regionId, issuedAt])
  @@index([driverPersonId])
  @@index([plateNumber])
}

model TrafficPayment {
  id                   String               @id @default(cuid())
  number               String               @unique
  fineId               String
  fine                 TrafficFine          @relation(fields: [fineId], references: [id])
  amountFcfa           Int
  method               TrafficPaymentMethod
  provider             String?
  transactionReference String?
  paidAt               DateTime
  receivedById         String
  receivedBy           User                 @relation("TrafficPaymentReceivedBy", fields: [receivedById], references: [id])
  stationId            String?
  station              Station?             @relation(fields: [stationId], references: [id])
  paymentPoint         String?
  status               TrafficPaymentStatus @default(COMPLETED)
  voidedAt             DateTime?
  voidedById           String?
  voidedBy             User?                @relation("TrafficPaymentVoidedBy", fields: [voidedById], references: [id])
  voidReason           String?
  notes                String?
  createdAt            DateTime             @default(now())

  receipt         TrafficReceipt?
  cashTransaction TrafficCashTransaction?
  depositItems    TrafficDepositItem[]

  @@unique([method, transactionReference])
  @@index([fineId])
  @@index([paidAt])
}

model TrafficReceipt {
  id                String         @id @default(cuid())
  number            String         @unique
  verificationToken String         @unique
  paymentId         String         @unique
  payment           TrafficPayment @relation(fields: [paymentId], references: [id])
  fineId            String
  fine              TrafficFine    @relation(fields: [fineId], references: [id])
  amountFcfa        Int
  issuedAt          DateTime       @default(now())
  issuedById        String
  issuedBy          User           @relation("TrafficReceiptIssuedBy", fields: [issuedById], references: [id])

  @@index([fineId])
}

model TrafficEvidence {
  id           String              @id @default(cuid())
  controlId    String
  control      TrafficControl      @relation(fields: [controlId], references: [id])
  kind         TrafficEvidenceKind @default(PHOTO)
  documentId   String              @unique
  document     Document            @relation(fields: [documentId], references: [id])
  caption      String?
  latitude     Float?
  longitude    Float?
  capturedAt   DateTime?
  uploadedById String
  uploadedBy   User                @relation("TrafficEvidenceUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime            @default(now())

  @@index([controlId])
}

/**
 * ================================================================== field revenue: cash registers, deposits, reconciliation
 */

enum TrafficCashRegisterStatus {
  OPEN
  CLOSED
  PENDING_DEPOSIT
  DEPOSITED
  VALIDATED
  BLOCKED
}

enum TrafficCollectionStatus {
  TO_DEPOSIT
  PARTIALLY_DEPOSITED
  DEPOSITED
  VALIDATED
}

enum TrafficDepositStatus {
  SUBMITTED
  VERIFIED
  JUSTIFICATION_REQUESTED
  VALIDATED
  REJECTED
}

enum TrafficDepositMethod {
  BANK
  TREASURY
  CENTRAL_CASH
  MOBILE_MONEY
  OTHER
}

enum TrafficReconciliationStatus {
  PENDING
  CONFORME
  GAP_TO_JUSTIFY
  VALIDATED
  REJECTED
}

enum TrafficDiscrepancyStatus {
  OPEN
  JUSTIFIED
  VALIDATED
  REJECTED
}

/// The electronic cash register of a collecting agent. One OPEN register per agent (partial unique index).
model TrafficCashRegister {
  id                 String                    @id @default(cuid())
  number             String                    @unique
  agentId            String
  agent              User                      @relation("CashRegisterAgent", fields: [agentId], references: [id])
  agentBadge         String?
  stationId          String
  station            Station                   @relation(fields: [stationId], references: [id])
  regionId           String
  region             Region                    @relation(fields: [regionId], references: [id])
  status             TrafficCashRegisterStatus @default(OPEN)
  openedAt           DateTime                  @default(now())
  openingBalanceFcfa Int                       @default(0)
  closedAt           DateTime?
  closedById         String?
  closedBy           User?                     @relation("CashRegisterClosedBy", fields: [closedById], references: [id])
  blockedAt          DateTime?
  blockedById        String?
  blockedBy          User?                     @relation("CashRegisterBlockedBy", fields: [blockedById], references: [id])
  blockReason        String?
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  transactions  TrafficCashTransaction[]
  closure       TrafficDailyClosure?
  collection    TrafficRevenueCollection?
  deposits      TrafficDeposit[]
  discrepancies TrafficCashDiscrepancy[]

  @@index([agentId, status])
  @@index([stationId, openedAt])
  @@index([regionId, openedAt])
}

/// One line per payment collected into a register. `paymentId` is unique: a payment can never be counted twice.
model TrafficCashTransaction {
  id         String               @id @default(cuid())
  registerId String
  register   TrafficCashRegister  @relation(fields: [registerId], references: [id])
  paymentId  String               @unique
  payment    TrafficPayment       @relation(fields: [paymentId], references: [id])
  amountFcfa Int
  method     TrafficPaymentMethod
  recordedAt DateTime             @default(now())
  voidedAt   DateTime?

  @@index([registerId])
}

/// Daily closing statement (état journalier des recettes): frozen at closing, append-only.
model TrafficDailyClosure {
  id                  String              @id @default(cuid())
  number              String              @unique
  registerId          String              @unique
  register            TrafficCashRegister @relation(fields: [registerId], references: [id])
  paymentsCount       Int
  finesTotalFcfa      Int
  collectedFcfa       Int
  cashFcfa            Int
  electronicFcfa      Int
  mobileMoneyFcfa     Int
  otherFcfa           Int
  amountToDepositFcfa Int
  receiptNumbers      Json
  ticketNumbers       Json
  closedById          String
  closedBy            User                @relation("DailyClosureClosedBy", fields: [closedById], references: [id])
  closedAt            DateTime            @default(now())
  notes               String?

  collection TrafficRevenueCollection?
}

/// The revenue a closed register owes to the administration, and how much of it has been deposited / validated.
model TrafficRevenueCollection {
  id            String                  @id @default(cuid())
  number        String                  @unique
  registerId    String                  @unique
  register      TrafficCashRegister     @relation(fields: [registerId], references: [id])
  closureId     String                  @unique
  closure       TrafficDailyClosure     @relation(fields: [closureId], references: [id])
  agentId       String
  agent         User                    @relation("RevenueCollectionAgent", fields: [agentId], references: [id])
  stationId     String
  station       Station                 @relation(fields: [stationId], references: [id])
  regionId      String
  region        Region                  @relation(fields: [regionId], references: [id])
  periodFrom    DateTime
  periodTo      DateTime
  collectedFcfa Int
  depositedFcfa Int                     @default(0)
  validatedFcfa Int                     @default(0)
  status        TrafficCollectionStatus @default(TO_DEPOSIT)
  verifiedById  String?
  verifiedBy    User?                   @relation("RevenueCollectionVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  deposits       TrafficDeposit[]
  reconciliation TrafficReconciliation?
  discrepancies  TrafficCashDiscrepancy[]

  @@index([stationId, createdAt])
  @@index([regionId, createdAt])
  @@index([agentId])
}

model TrafficDeposit {
  id                   String                   @id @default(cuid())
  number               String                   @unique
  collectionId         String
  collection           TrafficRevenueCollection @relation(fields: [collectionId], references: [id])
  registerId           String
  register             TrafficCashRegister      @relation(fields: [registerId], references: [id])
  agentId              String
  agent                User                     @relation("DepositAgent", fields: [agentId], references: [id])
  agentBadge           String?
  stationId            String
  station              Station                  @relation(fields: [stationId], references: [id])
  regionId             String
  region               Region                   @relation(fields: [regionId], references: [id])
  periodFrom           DateTime
  periodTo             DateTime
  collectedFcfa        Int
  amountDueFcfa        Int
  amountDepositedFcfa  Int
  method               TrafficDepositMethod
  slipNumber           String?
  reference            String?
  recipient            String?
  depositedAt          DateTime
  depositedById        String
  depositedBy          User                     @relation("DepositMadeBy", fields: [depositedById], references: [id])
  receivedById         String?
  receivedBy           User?                    @relation("DepositReceivedBy", fields: [receivedById], references: [id])
  observations         String?
  attachmentDocumentId String?                  @unique
  attachmentDocument   Document?                @relation(fields: [attachmentDocumentId], references: [id])
  status               TrafficDepositStatus     @default(SUBMITTED)
  attempt              Int                      @default(1)
  previousDepositId    String?
  reviewedById         String?
  reviewedBy           User?                    @relation("DepositReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt           DateTime?
  reviewNote           String?
  validatedById        String?
  validatedBy          User?                    @relation("DepositValidatedBy", fields: [validatedById], references: [id])
  validatedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  items TrafficDepositItem[]
  slip  TrafficDepositReceipt?

  @@index([collectionId])
  @@index([status])
  @@index([stationId, depositedAt])
  @@index([regionId, depositedAt])
}

/// Snapshot of the payments covered by a deposit (traceability: PV → fine → payment → receipt → deposit).
model TrafficDepositItem {
  id         String         @id @default(cuid())
  depositId  String
  deposit    TrafficDeposit @relation(fields: [depositId], references: [id])
  paymentId  String
  payment    TrafficPayment @relation(fields: [paymentId], references: [id])
  amountFcfa Int

  @@unique([depositId, paymentId])
}

/// Bordereau de versement des recettes (append-only, verifiable by QR code).
model TrafficDepositReceipt {
  id                String         @id @default(cuid())
  number            String         @unique
  verificationToken String         @unique
  depositId         String         @unique
  deposit           TrafficDeposit @relation(fields: [depositId], references: [id])
  contentHash       String
  issuedAt          DateTime       @default(now())
  issuedById        String
  issuedBy          User           @relation("DepositSlipIssuedBy", fields: [issuedById], references: [id])
}

model TrafficReconciliation {
  id            String                      @id @default(cuid())
  number        String                      @unique
  collectionId  String                      @unique
  collection    TrafficRevenueCollection    @relation(fields: [collectionId], references: [id])
  collectedFcfa Int
  depositedFcfa Int
  validatedFcfa Int
  gapFcfa       Int
  status        TrafficReconciliationStatus @default(PENDING)
  computedAt    DateTime                    @default(now())
  decidedById   String?
  decidedBy     User?                       @relation("ReconciliationDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  note          String?
  updatedAt     DateTime                    @updatedAt

  discrepancies TrafficCashDiscrepancy[]
}

model TrafficCashDiscrepancy {
  id                   String                   @id @default(cuid())
  number               String                   @unique
  reconciliationId     String
  reconciliation       TrafficReconciliation    @relation(fields: [reconciliationId], references: [id])
  collectionId         String
  collection           TrafficRevenueCollection @relation(fields: [collectionId], references: [id])
  registerId           String
  register             TrafficCashRegister      @relation(fields: [registerId], references: [id])
  agentId              String
  agent                User                     @relation("DiscrepancyAgent", fields: [agentId], references: [id])
  amountFcfa           Int
  reason               String?
  justification        String?
  attachmentDocumentId String?                  @unique
  attachmentDocument   Document?                @relation(fields: [attachmentDocumentId], references: [id])
  status               TrafficDiscrepancyStatus @default(OPEN)
  validatedById        String?
  validatedBy          User?                    @relation("DiscrepancyValidatedBy", fields: [validatedById], references: [id])
  validatedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status])
  @@index([agentId])
}

// ------------------------------------------------------------
// NATIONAL ALERT NETWORK (SIGPN-T v2.0, section 5)
// ------------------------------------------------------------

/// Perimeter of diffusion approved for a wanted notice.
enum WantedDiffusion {
  NATIONAL
  REGIONAL
  LOCAL
}

enum AlertKind {
  PUBLISHED
  UPDATED
  SUSPENDED
  REACTIVATED
  WITHDRAWN
  EXPIRED
  CLOSED
}

enum AlertDeliveryStatus {
  PENDING
  DELIVERED
  READ
  ACKNOWLEDGED
  FAILED
}

/// One national event per approved change of a wanted notice. Immutable (trigger): the durable queue of the network.
/// `payload` is a minimal snapshot: no investigation detail, informants or case content.
model NationalAlert {
  id             String          @id @default(cuid())
  seq            Int             @unique @default(autoincrement())
  number         String          @unique
  kind           AlertKind
  wantedPersonId String?
  wantedPerson   WantedPerson?   @relation(fields: [wantedPersonId], references: [id])
  idempotencyKey String          @unique
  diffusion      WantedDiffusion
  sourceStationId String
  sourceRegionId  String
  priority       DangerLevel     @default(MEDIUM)
  title          String
  payload        Json
  requiresAck    Boolean         @default(true)
  isSimulation   Boolean         @default(false)
  createdById    String
  createdAt      DateTime        @default(now())

  deliveries AlertDelivery[]

  @@index([wantedPersonId, seq])
  @@index([createdAt])
}

/// Delivery of an alert to one unit (station or sub-station) with its receipts. Retried and escalated by the scheduler.
model AlertDelivery {
  id              String              @id @default(cuid())
  alertId         String
  alert           NationalAlert       @relation(fields: [alertId], references: [id])
  stationId       String
  station         Station             @relation(fields: [stationId], references: [id])
  status          AlertDeliveryStatus @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime?
  deliveredAt     DateTime?
  deliveredById   String?
  readAt          DateTime?
  readById        String?
  ackAt           DateTime?
  ackById         String?
  escalatedAt     DateTime?
  escalationLevel Int                 @default(0)
  error           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([alertId, stationId])
  @@index([stationId, status])
  @@index([status, nextAttemptAt])
}

/// Connectivity of a unit: refreshed by the heartbeat of its clients. `simulatedOffline` is the demonstration switch.
model StationPresence {
  stationId        String   @id
  station          Station  @relation(fields: [stationId], references: [id])
  lastSeenAt       DateTime
  lastSyncAt       DateTime?
  lastUserId       String?
  simulatedOffline Boolean  @default(false)
}

// ------------------------------------------------------------
// BIOMETRIC CONTROL SCREEN (SIGPN-T v2.0, section 6) — demonstration simulator
// ------------------------------------------------------------

enum BiometricControlResult {
  POSSIBLE_MATCH
  UNCERTAIN
  NO_MATCH
  UNAVAILABLE
}

enum BiometricControlStatus {
  NEW
  VERIFICATION_REQUESTED
  SUPERIOR_NOTIFIED
  ERROR_REPORTED
  CONFIRMED_BY_HUMAN
  REJECTED_BY_HUMAN
}

enum BiometricErrorKind {
  FALSE_POSITIVE
  FALSE_NEGATIVE
  POOR_CAPTURE
  CONTESTED
}

/// One identity check at a control point. Always a SIMULATION in this version (fictitious identities, no real template
/// is matched, no image is stored). A result is an indication to verify, never evidence and never an order to arrest.
model BiometricControl {
  id                      String                 @id @default(cuid())
  number                  String                 @unique
  modality                BiometricType
  result                  BiometricControlResult
  score                   Decimal?               @db.Decimal(5, 2)
  captureQuality          Int
  referenceAlertId        String?
  subjectLabel            String?
  officerId               String
  stationId               String?
  device                  String?
  reason                  String
  status                  BiometricControlStatus @default(NEW)
  verificationRequestedAt DateTime?
  superiorNotifiedAt      DateTime?
  reviewedById            String?
  reviewedAt              DateTime?
  reviewNotes             String?
  errorKind               BiometricErrorKind?
  errorNotes              String?
  errorReportedAt         DateTime?
  isSimulation            Boolean                @default(true)
  createdAt               DateTime               @default(now())

  @@index([officerId, createdAt])
  @@index([stationId, createdAt])
  @@index([result])
}

// ------------------------------------------------------------
// PUBLIC PORTAL (SIGPN-T v2.0, sections 2.2 and 4): anonymous intake, news, directory
// ------------------------------------------------------------

enum PublicSubmissionKind {
  COMPLAINT
  REPORT
  CONTACT
}

enum PublicSubmissionStatus {
  RECEIVED
  IN_REVIEW
  FORWARDED
  CLOSED
  REJECTED
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

/// A complaint, report or contact message filed on the public site. Never an internal record: staff review it and may convert a
/// complaint into the internal complaint workflow. The tracking code is only stored hashed.
model PublicSubmission {
  id             String                 @id @default(cuid())
  number         String                 @unique
  codeHash       String
  kind           PublicSubmissionKind
  category       OffenseCategory        @default(OTHER)
  subject        String
  message        String
  locationText   String?
  occurredOn     DateTime?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  anonymous      Boolean                @default(false)
  stationId      String?
  status         PublicSubmissionStatus @default(RECEIVED)
  publicReply    String?
  repliedAt      DateTime?
  handledById    String?
  complaintId    String?                @unique
  ipHash         String?
  receivedAt     DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, receivedAt])
  @@index([stationId, status])
}

model PublicNews {
  id          String     @id @default(cuid())
  title       String
  summary     String
  body        String
  status      NewsStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  isDemo      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}
