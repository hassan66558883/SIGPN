enum VehicleType {
  PATROL_CAR
  MOTORCYCLE
  VAN
  PICKUP
  TRUCK
  BUS
  UNMARKED
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  OUT_OF_SERVICE
  DECOMMISSIONED
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

model Vehicle {
  id                 String        @id @default(cuid())
  fleetNumber        String        @unique
  plateNumber        String        @unique
  vin                String?       @unique
  make               String
  model              String
  year               Int?
  color              String?
  type               VehicleType   @default(PATROL_CAR)
